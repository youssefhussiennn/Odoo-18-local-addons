<odoo>
    <record id="view_crm_form_inherit_vessel" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.vessel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="vessel_id" options="{'no_create': True}" placeholder="Select Vessel"/>             
            </xpath>
        </field>
    </record>
</odoo>