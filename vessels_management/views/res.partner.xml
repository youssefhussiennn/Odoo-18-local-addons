<odoo>
  <record id="view_partner_form_vessels_inherit" model="ir.ui.view">
    <field name="name">res.partner.vessels.inherit.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet//div[@name='button_box']" position="inside">
        <button name="action_view_vessels" type="object"
                class="oe_stat_button" icon="fa-ship">
          <field name="vessels_count" widget="statinfo" string="Vessels"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
