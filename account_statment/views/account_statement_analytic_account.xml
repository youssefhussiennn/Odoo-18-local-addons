                                        <td colspan="2">
                                            <span t-esc="abs(total_customer_allowed_discount_sales_person)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>
                                    
                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="11">
                                            <span style="float:right">اجمالي مشتريات</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="total_purchase_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>

                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="11">
                                            <span style="float:right; width:100px">شيكات ضمان</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="abs(total_safty_checks_sales_person)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>
                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="11">
                                            <span style="float:right;width:150px">شيكات تحت التحصيل</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="abs(total_collection_checks_sales_person)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>
                                </tbody>

                            </table>

                            <p style="page-break-before:always;"> </p>
                        </div>
                    </t>
                </t>
            </t>
