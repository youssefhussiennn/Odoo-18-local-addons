<odoo>
    <data>
        <record id="paperformat_portrait_account_statement_analytic_account" model="report.paperformat">
            <field name="name">Account Statement Layout</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">19</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">100</field>
        </record>


        <record id="action_report_account_statment_analytic_account" model="ir.actions.report">
            <field name="name">Account Statement Total</field>
            <field name="model">account.move.line</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account_statment.account_statment_analytic_account_document</field>
            <field name="report_file">account_statment.account_statment_analytic_account_document</field>
            <field name="paperformat_id" ref="account_statment.paperformat_portrait_account_statement_analytic_account" />
            <field name="binding_model_id" eval="False" />
            <field name="binding_type">report</field>
        </record>


        <template id="account_statment_analytic_account_document">
            <t t-call="web.html_container">
                <t t-call="account_statment.custom_external_layout_account_statment">
                    <t t-set="lines" t-value="docs.mapped('analytic_account_id')"/>
                    <t t-foreach="lines" t-as="o">
                        <t t-set="data" t-value="docs.filtered(lambda x: x.analytic_account_id.name == o.name).sorted(key=lambda x: x.date)"/>
                        <div class="page">
                            <br/>
                            <br/>
                            <div class="row" style="direction:rtl">
                                <div style="width:50%;" >
                                    <h4 style="float:right">التاريخ:
                                        <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d')"/>
                                    </h4>
                                </div>
                                <div style="width:50%;">
                                    <img t-if="data.company_id.logo"
                                        t-att-src="image_data_uri(data.company_id.logo)"
                                        style="max-height: 320px;max-width: 170px;float:left" alt="Logo"/>
                                </div>
                            </div>
                            <br/>
                            <div class="row">
                                <div style="width:100%">
                                    <center>
                                        <h3 style = "text-align:center">
                                            <!-- مبيعات المهندس -->
                                            <span t-field="data[0].analytic_account_id.name"/>
                                        </h3>
                                    </center>
                                </div>
                            </div>
                            <br/>
                            <table class="table table-bordered " style='direction: rtl;'>
                                <thead>
                                    <tr>
                                        <th class="text-right"><span style="float:right">اسم العميل</span></th>
                                        <th class="text-right"><span style="float:right">الرصيد الافتتاحي</span></th>
                                        <th class="text-right"><span style="float:right">اجمالي مبيعات</span></th>
                                        <th class="text-right"><span style="float:right">اجمالي الخصم</span></th>
                                        <!-- <th class="text-right"><span style="float:right">نسبة الخصم</span></th> -->
                                        <th class="text-right"><span style="float:right">صافي مبيعات</span></th>
                                        <th class="text-right"><span style="float:right">اجمالي مرتجعات</span></th>
                                        <th class="text-right"><span style="float:right">الخصم الممنوح للعميل</span></th>
                                        <th class="text-right"><span style="float:right">اجمالي سداد</span></th>
                                        <!-- <th class="text-right"><span style="float:right">نسبة التحصيل</span></th>
                                        <th class="text-right"><span style="float:right">نسبة المرتجعات</span></th> -->
                                        <th class="text-right"><span style="float:right">اجمالي مشتريات</span></th>
                                        <th class="text-right"><span style="float:right">الرصيد</span></th>
                                        <th class="text-right"><span style="float:right">المتأخر</span></th>
                                        <th class="text-right"><span style="float:right">شيكات ضمان</span></th>
                                        <th class="text-right"><span style="float:right">شيكات تحت التحصيل</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Sales Person Total Line Fields-->
                                    <t t-set="total_initial_balance_sales_person" t-value="0"/>
                                    <t t-set="total_sales_after_discount_sales_person" t-value="0"/>
                                    <t t-set="total_sales_before_discount_sales_person" t-value="0"/>
                                    <t t-set="total_purchase_sales_person" t-value="0"/>
                                    <t t-set="total_refund_sales_person" t-value="0"/>
                                    <t t-set="total_payment_sales_person" t-value="0"/>
                                    <t t-set="total_safty_checks_sales_person" t-value="0"/>
                                    <t t-set="total_collection_checks_sales_person" t-value="0"/>
                                    <t t-set="total_customer_allowed_discount_sales_person" t-value="0"/>
                                    <t t-set="total_discount_sales_person" t-value="0"/>
                                    <t t-set="balance_sales_person" t-value="0"/>
                                    <t t-set="total_due_amount_sales_person" t-value="0"/>


                                    <t t-set="accountings" t-value="data.mapped('partner_id')"/>
                                    <t t-foreach="accountings" t-as="account">
                                        
                                        <t t-set="final_lines" t-value="data.filtered(lambda x: x.partner_id.name == account.name).sorted(key=lambda x: x.date)"/>
                                        
                                        <t t-set="total_initial_balance" t-value="request.env['account.move.line'].sudo().get_initial_balance(final_lines[0].partner_id, data[0].date)"/>
                                        <t t-set="total_initial_balance_sales_person" t-value="round((total_initial_balance_sales_person +request.env['account.move.line'].sudo().get_initial_balance(final_lines[0].partner_id, data[0].date)),2)"/>
                                        <!-- <t t-set="balance_sales_person" t-value="round((balance_sales_person +request.env['account.move.line'].sudo().get_initial_balance(final_lines[0].partner_id, data[0].date)),2)"/> -->
                                        <t t-set="balance" t-value="total_initial_balance"/>
                                        <t t-set="total_sales_after_discount" t-value="0"/>
                                        <t t-set="total_sales_before_discount" t-value="0"/>
                                        <t t-set="discount" t-value="0"/>
                                        <t t-set="total_purchase" t-value="0"/>
                                        <t t-set="total_refund" t-value="0"/>
                                        <t t-set="total_payment" t-value="0"/>
                                        <t t-set="total_debit" t-value="0"/>
                                        <t t-set="total_credit" t-value="0"/>
                                        <t t-set="total_safty_checks" t-value="0"/>
                                        <t t-set="total_collection_checks" t-value="0"/>
                                        <t t-set="total_customer_allowed_discount" t-value="0"/>
                                        <t t-set="total_discount" t-value="0"/>
                                        <t t-set="purchase_total_discount" t-value="0"/>
                                        <t t-set="old_invoices" t-value="'moves:'"/>
                                        <t t-set="total_due_amount" t-value="0"/>
                                        


                                        <t t-foreach="final_lines" t-as="line">
                                            <t t-if="line.account_id.customer_allowed_discount == True">
                                                <t t-set="total_customer_allowed_discount" t-value="round((total_customer_allowed_discount - line.credit),2)"/>
                                                <t t-set="total_customer_allowed_discount" t-value="round((total_customer_allowed_discount + line.debit),2)"/>
                                                <t t-set="total_customer_allowed_discount_sales_person" t-value="round((total_customer_allowed_discount_sales_person - line.credit),2)"/>
                                                <t t-set="total_customer_allowed_discount_sales_person" t-value="round((total_customer_allowed_discount_sales_person + line.debit),2)"/>

                                            </t>
                                            <t t-if="line.move_id.move_type == 'entry' and line.account_id.is_safty_account == True">
                                                <t t-set="total_safty_checks" t-value="round((total_safty_checks - line.credit),2)"/>
                                                <t t-set="total_safty_checks" t-value="round((total_safty_checks + line.debit),2)"/>
                                                <t t-set="total_safty_checks_sales_person" t-value="round((total_safty_checks_sales_person - line.credit),2)"/>
                                                <t t-set="total_safty_checks_sales_person" t-value="round((total_safty_checks_sales_person + line.debit),2)"/>
                                            </t>
    
                                            <t t-elif="line.move_id.move_type == 'entry' and line.account_id.is_collection_account == True">
                                                <t t-set="total_collection_checks" t-value="round((total_collection_checks - line.credit),2)"/>
                                                <t t-set="total_collection_checks" t-value="round((total_collection_checks + line.debit),2)"/>
                                                <t t-set="total_collection_checks_sales_person" t-value="round((total_collection_checks_sales_person + line.debit),2)"/>
                                                <t t-set="total_collection_checks_sales_person" t-value="round((total_collection_checks_sales_person - line.credit),2)"/>

                                            </t>
                                            
                                            <t t-elif="line.move_id.move_type == 'entry' and line.account_id.is_safty_account == False and line.account_id.is_collection_account == False and line.account_id.customer_allowed_discount == False and line.move_id.is_customer_discount == False">
                                                <t t-if="line.move_id.is_opening_balance == False">
                                                    <t t-set="total_payment" t-value="round((total_payment + (line.credit-line.debit)),2)"/>
                                                    <t t-set="total_payment_sales_person" t-value="round((total_payment_sales_person + (line.credit-line.debit)),2)"/>
                                                    
                                                </t>

                                                <t t-if="line.move_id.is_opening_balance == True">
                                                    <!-- <t t-set="total_payment" t-value="round((total_payment + (line.credit-line.debit)),2)"/>
                                                    <t t-set="total_payment_sales_person" t-value="round((total_payment_sales_person ++ (line.credit-line.debit)),2)"/> -->
                                                    <t t-set="total_initial_balance" t-value="total_initial_balance + (line.debit - line.credit)"/>
                                                    <t t-set="total_initial_balance_sales_person" t-value="total_initial_balance_sales_person + (line.debit-line.credit)"/>
                                                    
                                                </t>
                                                <!-- <t t-set="balance" t-value="round((balance - line.credit),2)"/>
                                                <t t-set="balance" t-value="round((balance + line.debit),2)"/> -->
                                                <!-- <t t-set="balance_sales_person" t-value="round((balance_sales_person - line.credit),2)"/>
                                                <t t-set="balance_sales_person" t-value="round((balance_sales_person + line.debit),2)"/> -->

                                                <t t-set="total_credit" t-value="round((total_credit + line.credit),2)"/>
                                            </t>
    
                                            <t t-if="line.move_id.invoice_line_ids and line.move_id.move_type in ('out_refund', 'in_refund', 'out_invoice', 'in_invoice') and line.account_id.is_safty_account == False and line.account_id.is_collection_account == False and line.account_id.customer_allowed_discount == False and line.move_id.name not in old_invoices and line.move_id.is_customer_discount == False">
                                                <t t-set="old_invoices" t-value="old_invoices+ ' , '+ line.move_id.name"/>
                                                <t t-foreach="line.move_id.invoice_line_ids" t-as="inv">
                                                    <!-- <tr> -->
                                                    <t t-if="inv.discount > 0 and line.move_id.move_type in ('out_invoice')">
                                                        <t t-set="total_discount" t-value="round((total_discount + (inv.price_unit * ((inv.discount or 0.0) / 100.0) * inv.quantity)),2)"/>
                                                        <t t-set="total_discount_sales_person" t-value="round((total_discount_sales_person +(inv.price_unit * ((inv.discount or 0.0) / 100.0) * inv.quantity)),2)"/>
                                                    </t>

                                                    <t t-if="inv.discount > 0 and line.move_id.move_type in ('in_invoice')">
                                                        <t t-set="purchase_total_discount" t-value="round((purchase_total_discount + (inv.price_unit * ((inv.discount or 0.0) / 100.0) * inv.quantity)),2)"/>
                                                    </t>

                                                    <t t-if="line.move_id.move_type not in ('out_refund', 'in_invoice')">
                                                        <t t-set="total_debit" t-value="round((total_debit + inv.price_subtotal),2)"/>
                                                        <!-- <t t-set="balance" t-value="round((balance + inv.price_subtotal),2)"/>
                                                        <t t-set="balance_sales_person" t-value="round((balance_sales_person + inv.price_subtotal),2)"/> -->
                                                    </t>
                                                    <t t-else="">
                                                        <t t-set="total_credit" t-value="round((total_credit + inv.price_subtotal),2)"/>
                                                        <!-- <t t-set="balance" t-value="round((balance - inv.price_subtotal),2)"/>
                                                        <t t-set="balance_sales_person" t-value="round((balance_sales_person - inv.price_subtotal),2)"/> -->
                                                    </t>
                                                    <t t-if="line.move_id.move_type in ('out_refund', 'in_refund')">
                                                        <t t-set="total_refund" t-value="round((total_refund + inv.price_subtotal),2)"/>
                                                        <t t-set="total_refund_sales_person" t-value="round((total_refund_sales_person +inv.price_subtotal),2)"/>

                                                    </t>
                                                    <t t-if="line.move_id.move_type in ('in_invoice')">
                                                        <t t-set="total_purchase" t-value="round((total_purchase + inv.price_subtotal),2)"/>
                                                        <t t-set="total_purchase_sales_person" t-value="round((total_purchase_sales_person +inv.price_subtotal),2)"/>
                                                    </t>

                                                    <t t-if="line.move_id.move_type in ('out_invoice')">
                                                        <t t-set="total_sales_after_discount" t-value="round((total_sales_after_discount + inv.price_subtotal),2)"/>
                                                        <t t-set="total_sales_before_discount" t-value="round((total_sales_before_discount + (inv.quantity*inv.price_unit)),2)"/>
                                                        <t t-set="total_sales_before_discount_sales_person" t-value="round((total_sales_before_discount_sales_person +(inv.quantity*inv.price_unit)),2)"/>
                                                        <t t-set="total_sales_after_discount_sales_person" t-value="round((total_sales_after_discount_sales_person +inv.price_subtotal),2)"/>

                                                    </t>
                                                    
                                                    <!-- </tr> -->
                                                </t>
                                                <t t-if="line.move_id.move_type in ('out_invoice', 'in_refund') and line.move_id.payment_state in ('not_paid', 'partial', 'in_payment') and datetime.datetime.strptime(str(line.move_id.invoice_date_due), '%Y-%m-%d') &lt; datetime.datetime.strptime(datetime.datetime.now().strftime('%Y-%m-%d'), '%Y-%m-%d')">
                                                    <t t-set="total_due_amount" t-value="total_due_amount + line.move_id.amount_residual"/>
                                                    <t t-set="total_due_amount_sales_person" t-value="total_due_amount_sales_person + line.move_id.amount_residual"/>
                                                </t>
                                            </t>
                                        </t>
                                        <tr>
                                            <td class="text-right">
                                                <span t-field="final_lines[0].partner_id.name"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="abs(total_initial_balance)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
                                                
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="total_sales_before_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
                                                
                                            </td>
                                            <td class="text-right">
                                                <t t-if="total_discount !=0">
                                                    <span t-esc="total_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="discount" t-value="0"/>
    
                                                    <span t-esc="discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                                </t>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="total_sales_after_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="total_refund" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="abs(total_customer_allowed_discount)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="total_payment" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="total_purchase" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <t t-set="balance" t-value="round((total_initial_balance + total_sales_after_discount - total_refund - total_payment - total_purchase - total_customer_allowed_discount),2)"/>
                                                <t t-set="balance_sales_person" t-value="round((balance_sales_person + total_initial_balance + total_sales_after_discount - total_refund - total_payment - total_purchase - total_customer_allowed_discount),2)"/>
                                                <span t-esc="balance" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="total_due_amount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="abs(total_safty_checks)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="abs(total_collection_checks)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
    
                                            </td>
                                        </tr>
                                    </t>



                                    <!--Total Line for each sales person-->
                                    
                                    <tr>
                                        <td colspan="11">
                                            <span style="float:right">اجمالي رصيد الافتتاحي</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="total_initial_balance_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>
                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="11">
                                            <span style="float:right">اجمالي الرصيد</span>

                                        </td>
                                        <td colspan="2">
                                            <!-- <t t-set="balance_sales_person" t-value="balance_sales_person + total_initial_balance_sales_person"/> -->
                                            <span t-esc="balance_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>

                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="11">
                                            <span style="float:right">اجمالي المتأخر</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="total_due_amount_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>

                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="11">
                                            <span style="float:right">اجمالي المبيعات</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="total_sales_before_discount_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>

                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="5">
                                            <span style="float:right">اجمالي الخصم</span>

                                        </td>
                                        <td colspan="2">
                                            <!-- <span t-esc="total_discount - total_sales_after_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/> -->
                                            <t t-if="total_discount_sales_person !=0">
                                                <span t-esc="total_discount_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
                                            </t>
                                            <t t-else="">
                                                <t t-set="discount" t-value="0"/>

                                                <span t-esc="discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                            </t>
                                        </td>
                                        <td colspan="5">
                                            <span style="float:right">نسبة الخصم</span>

                                        </td>
                                        <td colspan="2">
                                            <t t-if="total_sales_before_discount_sales_person!=0">
                                                <t t-set="discount_percentage" t-value="round(((total_discount_sales_person/total_sales_before_discount_sales_person)*100),2)"/>

                                            </t>
                                            <span t-esc="discount_percentage"/>
                                            <span>%</span>

                                        </td>
                                    </tr>

                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="11">
                                            <span style="float:right;width:150px">اجمالي صافي المبيعات</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="total_sales_after_discount_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                    </tr>

                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="5">
                                            <span style="float:right">اجمالي سداد</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="total_payment_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

                                        </td>
                                        <td colspan="5">
                                            <span style="float:right">نسبة التحصيل</span>

                                        </td>
                                        <td colspan="2">
                                            <t t-set="payment_percentage" t-value="0"/>
                                            <t t-if="balance_sales_person !=0 and total_payment_sales_person!=0">
                                                <t t-set="new_balance_sales_person" t-value="balance_sales_person+total_payment_sales_person"/>
                                                <t t-if="new_balance_sales_person !=0">
                                                    <t t-set="payment_percentage" t-value="round(((total_payment_sales_person/(balance_sales_person+total_payment_sales_person))*100),2)"/>
                                                </t>

                                            </t>
                                            <span t-esc="payment_percentage"/>
                                            <span>%</span>

                                        </td>
                                    </tr>

                                    <tr style="background-color:#eeeeee;">
                                        <td colspan="5">
                                            <span style="float:right">اجمالي مرتجعات</span>

                                        </td>
                                        <td colspan="2">
                                            <span t-esc="total_refund_sales_person" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>

