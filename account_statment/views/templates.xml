<odoo>
    <data>
        <record id="paperformat_portrait" model="report.paperformat">
            <field name="name">Account Statement Layout</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">19</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">100</field>
        </record>

        <record id="action_report_account_statment_layout" model="ir.actions.report">
            <field name="name">Account Statement</field>
            <field name="model">account.move.line</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account_statment.account_statment_document</field>
            <field name="report_file">account_statment.account_statment_document</field>
            <field name="paperformat_id" ref="account_statment.paperformat_portrait" />
            <field name="binding_model_id" eval="False" />
            <field name="binding_type">report</field>
        </record>

        <template id="custom_external_layout_footer_account_statment">
            <div/>
        </template>

        <template id="custom_external_layout_account_statment">
            <t t-if="not company">
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
            <div t-attf-class="o_company_#{company.id}_layout article o_report_layout_background"
                 t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-call="web.address_layout"/>
                <t t-raw="0"/>
            </div>
            <t t-call="account_statment.custom_external_layout_footer_account_statment"/>
        </template>

        <template id="account_statment_document">
            <t t-call="web.html_container">
                <t t-call="account_statment.custom_external_layout_account_statment">
                    <t t-set="lines" t-value="docs.mapped('partner_id')"/>

                    <t t-foreach="lines" t-as="o">
                        <t t-set="data" t-value="docs.filtered(lambda x: x.partner_id.name == o.name).sorted(key=lambda x: x.date)"/>
                        <div class="page">
                            <t t-set="total_initial_balance" t-value="request.env['account.move.line'].sudo().with_context(curr=data[0].currency_id).get_initial_balance(data[0].partner_id, data[0].date)"/>
                            <br/>
                            <br/>
                            <div class="row" style="direction:rtl">
                                <div style="width:50%;">
                                    <h4 style="float:right">التاريخ: <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d')"/></h4>
                                </div>
                                <div style="width:50%;">
                                    <img t-if="data.company_id.logo" t-att-src="image_data_uri(data.company_id.logo)" style="max-height: 320px;max-width: 170px;float:left" alt="Logo"/>
                                </div>
                            </div>
                            <div class="row">
                                <div style="width:100%">
                                    <center><h3 style="text-align:center" t-field="data.company_id.name"/></center>
                                </div>
                            </div>
                            <br/>
                            <div class="row">
                                <div style="width:100%">
                                    <center>
                                        <h3 style="text-align:center">كشف حساب تفصيلي اصناف العميل <span t-field="data[0].partner_id.name"/></h3>
                                    </center>
                                </div>
                            </div>
                            <br/>

                            <table class="table table-bordered" style="direction:rtl; font-size:10px;">
                                <thead>
                                    <tr>
                                        <th class="text-right"><span style="float:right">تاريخ</span></th>
                                        <th class="text-right"><span style="float:right">مستند</span></th>
                                        <th class="text-right"><span style="float:right">بيان</span></th>
                                        <th class="text-right"><span style="float:right">الصنف</span></th>
                                        <th class="text-right"><span style="float:right">كمية</span></th>
                                        <th class="text-right"><span style="float:right">سعر</span></th>
                                        <th class="text-right"><span style="float:right">مدين</span></th>
                                        <th class="text-right"><span style="float:right">دائن</span></th>
                                        <th class="text-right"><span>رصيد</span></th>
                                        <th class="text-right"><span>ضريبه</span></th>
                                        <th class="text-right"><span>شيكات الضمان</span></th>
                                        <th class="text-right"><span>شيكات تحت التحصيل</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="balance"                        t-value="total_initial_balance"/>
                                    <t t-set="old_invoices"                   t-value="'moves:'"/>
                                    <t t-set="total_sales_after_discount"     t-value="0"/>
                                    <t t-set="total_sales_before_discount"    t-value="0"/>
                                    <t t-set="discount"                       t-value="0"/>
                                    <t t-set="total_purchase"                 t-value="0"/>
                                    <t t-set="total_refund"                   t-value="0"/>
                                    <t t-set="total_payment"                  t-value="0"/>
                                    <t t-set="total_debit"                    t-value="0"/>
                                    <t t-set="total_credit"                   t-value="0"/>
                                    <t t-set="total_safty_checks"             t-value="0"/>
                                    <t t-set="total_collection_checks"        t-value="0"/>
                                    <t t-set="total_discount"                 t-value="0"/>
                                    <t t-set="purchase_total_discount"        t-value="0"/>
                                    <t t-set="total_customer_allowed_discount" t-value="0"/>

                                    <!-- Opening Balance Row -->
                                    <tr>
                                        <td colspan="8"><span style="float:right">رصيد افتتاحي</span></td>
                                        <t t-set="total_initial_balance" t-value="total_initial_balance + abs(sum(data.filtered(lambda x: x.move_id.is_opening_balance == True).mapped('amount_currency')))"/>
                                        <t t-set="balance"               t-value="total_initial_balance"/>
                                        <t t-set="total_initial_balance" t-value="round((total_initial_balance), 2)"/>
                                        <td>
                                            <span t-esc="total_initial_balance" t-options="{'widget': 'monetary', 'display_currency': data.currency_id[0]}"/>
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>

                                    <!-- Main Loop -->
                                    <t t-foreach="data" t-as="line">

                                        <!-- Safety Cheque -->
                                        <t t-if="line.account_id.is_safty_account == True">
                                            <t t-set="line_safty_amount" t-value="round(abs(line.amount_currency), 2)"/>
                                            <t t-set="total_safty_checks" t-value="round((total_safty_checks + line_safty_amount), 2)"/>
                                            <tr>
                                                <td class="text-right"><span style="float:right" t-field="line.date"/></td>
                                                <td class="text-right"><span style="float:right" t-field="line.move_id.name"/></td>
                                                <td class="text-right"><span style="float:right">شيك ضمان</span></td>
                                                <td class="text-right"><span style="float:right" t-field="line.name"/></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-right">
                                                    <span style="float:right" t-esc="line_safty_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </t>

                                        <!-- Collection Cheque -->
                                        <t t-elif="line.account_id.is_collection_account == True">
                                            <t t-set="line_collection_amount" t-value="round(abs(line.amount_currency), 2)"/>
                                            <t t-set="total_collection_checks" t-value="round((total_collection_checks + line_collection_amount), 2)"/>
                                            <tr>
                                                <td class="text-right"><span style="float:right" t-field="line.date"/></td>
                                                <td class="text-right"><span style="float:right" t-field="line.move_id.name"/></td>
                                                <td class="text-right"><span style="float:right">شيك تحت التحصيل</span></td>
                                                <td class="text-right"><span style="float:right" t-field="line.name"/></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-right">
                                                    <span style="float:right" t-esc="line_collection_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- Customer Allowed Discount -->
                                        <t t-elif="line.account_id.customer_allowed_discount == True">
                                            <t t-set="total_customer_allowed_discount" t-value="round((total_customer_allowed_discount + line.amount_currency), 2)"/>
                                        </t>

                                        <!-- Journal Entry (payment) -->
                                        <t t-elif="line.move_id.move_type == 'entry' and line.account_id.is_safty_account == False and line.account_id.is_collection_account == False and line.account_id.customer_allowed_discount == False and line.move_id.is_customer_discount == False">
                                            <t t-if="line.move_id.is_opening_balance == False">
                                                <tr>
                                                    <td class="text-right"><span style="float:right" t-field="line.date"/></td>
                                                    <td class="text-right"><span t-field="line.move_id.name"/></td>
                                                    <td class="text-right">
                                                        <t t-if="line.journal_id.type == 'bank'">
                                                            <span style="float:right">شيك</span>
                                                        </t>
                                                        <t t-elif="line.journal_id.type == 'general'">
                                                            <span style="float:right">قيود عامة</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="float:right">سداد نقدي</span>
                                                        </t>
                                                    </td>
                                                    <td class="text-right"><span style="float:right" t-field="line.name"/></td>
                                                    <td class="text-right"><span style="float:right">0</span></td>
                                                    <td class="text-right"><span style="float:right">0</span></td>
                                                    <t t-set="line_debit_cur"  t-value="round(line.amount_currency, 2) if line.amount_currency > 0 else 0"/>
                                                    <t t-set="line_credit_cur" t-value="round(-line.amount_currency, 2) if line.amount_currency &lt; 0 else 0"/>
                                                    <td class="text-right">
                                                        <t t-if="line_debit_cur != 0">
                                                            <span style="float:right" t-esc="line_debit_cur" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-right">
                                                        <t t-if="line_credit_cur != 0">
                                                            <span style="float:right" t-esc="line_credit_cur" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-right">
                                                        <t t-if="line.journal_id.type != 'general'">
                                                            <t t-set="total_payment" t-value="round((total_payment + (line_credit_cur - line_debit_cur)), 2)"/>
                                                        </t>
                                                        <t t-set="balance"      t-value="round((balance - line_credit_cur + line_debit_cur), 2)"/>
                                                        <t t-set="total_credit" t-value="round((total_credit + line_credit_cur), 2)"/>
                                                        <t t-set="x_studio_taxed_amount_total" t-value="0"/>
                                                        <t t-set="balance_with_tax" t-value="balance + x_studio_taxed_amount_total"/>
                                                        <span style="float:right" t-esc="balance_with_tax" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                    </td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                            </t>
                                        </t>

                                        <!-- Invoice / Refund -->
                                        <t t-if="line.move_id.invoice_line_ids and line.move_id.move_type in ('out_refund', 'in_refund', 'out_invoice', 'in_invoice') and line.account_id.is_safty_account == False and line.account_id.is_collection_account == False and line.account_id.customer_allowed_discount == False and line.move_id.name not in old_invoices and line.move_id.is_customer_discount == False">
                                            <t t-set="old_invoices" t-value="old_invoices + ' , ' + line.move_id.name"/>
                                            <t t-foreach="line.move_id.invoice_line_ids" t-as="inv">
                                                <t t-set="x_studio_taxed_amount_total"  t-value="0"/>
                                                <t t-set="x_studio_taxed_amount_total1" t-value="(inv.x_studio_taxed_amount)"/>
                                                <t t-set="x_studio_taxed_amount_total"  t-value="round((x_studio_taxed_amount_total + x_studio_taxed_amount_total1), 2)"/>
                                                <tr>
                                                    <td class="text-right"><span style="float:right" t-field="inv.date"/></td>
                                                    <td class="text-right"><span style="float:right" t-field="inv.move_id.name"/></td>
                                                    <td class="text-right">
                                                        <t t-if="line.move_id.move_type in ('out_refund', 'in_refund')">
                                                            <span style="float:right">مرتجع</span>
                                                        </t>
                                                        <t t-elif="line.move_id.move_type in ('in_invoice')">
                                                            <span style="float:right">فاتورة مشتريات</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="float:right">فاتورة مبيعات</span>
                                                        </t>
                                                    </td>
                                                    <td class="text-right"><span style="float:right" t-field="inv.name"/></td>
                                                    <td class="text-right"><span style="float:right" t-esc="round((inv.quantity), 2)"/></td>
                                                    <td class="text-right">
                                                        <span style="float:right" t-esc="round((inv.price_unit - ((inv.price_unit * inv.discount) / 100)), 2)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                        <t t-if="inv.discount &gt; 0 and line.move_id.move_type in ('out_invoice')">
                                                            <t t-set="total_discount" t-value="round((total_discount + (inv.price_unit * ((inv.discount or 0.0) / 100.0) * inv.quantity)), 2)"/>
                                                        </t>
                                                        <t t-if="inv.discount &gt; 0 and line.move_id.move_type in ('in_invoice')">
                                                            <t t-set="purchase_total_discount" t-value="round((purchase_total_discount + (inv.price_unit * ((inv.discount or 0.0) / 100.0) * inv.quantity)), 2)"/>
                                                        </t>
                                                    </td>
                                                    <!-- DEBIT -->
                                                    <td class="text-right">
                                                        <t t-if="line.move_id.move_type not in ('out_refund', 'in_invoice')">
                                                            <span style="float:right" t-esc="round(abs(inv.price_total), 2)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <!-- CREDIT -->
                                                    <td class="text-right">
                                                        <t t-if="line.move_id.move_type in ('out_refund', 'in_invoice')">
                                                            <span style="float:right" t-esc="round((inv.price_subtotal + x_studio_taxed_amount_total), 2)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                        </t>
                                                    </td>
                                                    <!-- BALANCE -->
                                                    <td class="text-right">
                                                        <t t-if="line.move_id.move_type not in ('out_refund', 'in_invoice')">
                                                            <t t-set="total_debit" t-value="round((total_debit + inv.price_subtotal + x_studio_taxed_amount_total), 2)"/>
                                                            <t t-set="balance"     t-value="round((balance + inv.price_subtotal + x_studio_taxed_amount_total), 2)"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-set="total_credit" t-value="round((total_credit + inv.price_subtotal + x_studio_taxed_amount_total), 2)"/>
                                                            <t t-set="balance"      t-value="round((balance - inv.price_subtotal - x_studio_taxed_amount_total), 2)"/>
                                                        </t>
                                                        <t t-if="line.move_id.move_type in ('out_refund', 'in_refund')">
                                                            <t t-set="total_refund" t-value="round((total_refund + inv.price_subtotal + x_studio_taxed_amount_total), 2)"/>
                                                        </t>
                                                        <t t-if="line.move_id.move_type in ('in_invoice')">
                                                            <t t-set="total_purchase" t-value="round((total_purchase + inv.price_subtotal), 2)"/>
                                                        </t>
                                                        <t t-if="line.move_id.move_type in ('out_invoice')">
                                                            <t t-set="total_sales_after_discount"  t-value="round((total_sales_after_discount + inv.price_subtotal), 2)"/>
                                                            <t t-set="total_sales_before_discount" t-value="round((total_sales_before_discount + (inv.quantity * inv.price_unit)), 2)"/>
                                                        </t>
                                                        <span style="float:right" t-esc="balance" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                    </td>
                                                    <!-- TAX -->
                                                    <td>
                                                        <span style="float:right" t-esc="x_studio_taxed_amount_total" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                    </td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                            </t>
                                        </t>

                                    </t>
                                    <!-- End foreach data -->

                                    <!-- Footer: Balance Row -->
                                    <tr>
                                        <td colspan="6"><span style="float:right">الرصيد</span></td>
                                        <td><span t-esc="total_debit"  t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td><span t-esc="total_credit" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td><span t-esc="balance"      t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>

                                    <!-- Total Sales -->
                                    <tr>
                                        <td colspan="9"><span style="float:right">اجمالي مبيعات</span></td>
                                        <td><span t-esc="total_sales_before_discount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td></td>
                                        <td></td>
                                    </tr>

                                    <!-- Total Discount -->
                                    <tr>
                                        <td colspan="9"><span style="float:right">اجمالي الخصم</span></td>
                                        <td><span t-esc="total_customer_allowed_discount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td></td>
                                        <td></td>
                                    </tr>

                                    <!-- Total Returns -->
                                    <tr>
                                        <td colspan="9"><span style="float:right">اجمالي مرتجعات</span></td>
                                        <td><span t-esc="total_refund" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td></td>
                                        <td></td>
                                    </tr>

                                    <!-- Net Sales -->
                                    <tr>
                                        <td colspan="9"><span style="float:right">صافي مبيعات</span></td>
                                        <td>
                                            <span t-esc="total_sales_before_discount - total_refund" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                        <td></td>
                                        <td></td>
                                    </tr>

                                    <!-- Total Payments -->
                                    <tr>
                                        <td colspan="9"><span style="float:right">اجمالي سداد</span></td>
                                        <td><span t-esc="abs(total_payment)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                        <td></td>
                                        <td></td>
                                    </tr>

                                    <!-- Total Safety Cheques -->
                                    <tr style="background-color:#fff3cd;">
                                        <td colspan="9"><span style="float:right; font-weight:bold;">اجمالي شيكات الضمان</span></td>
                                        <td></td>
                                        <td>
                                            <span style="float:right; font-weight:bold;" t-esc="abs(total_safty_checks)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                        <td></td>
                                    </tr>

                                    <!-- Total Collection Cheques -->
                                    <tr style="background-color:#e3f2fd;">
                                        <td colspan="9"><span style="float:right; font-weight:bold;">اجمالي شيكات تحت التحصيل</span></td>
                                        <td></td>
                                        <td></td>
                                        <td>
                                            <span style="float:right; font-weight:bold;" t-esc="abs(total_collection_checks)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                    </tr>

                                    <!-- Total All Cheques -->
                                    <tr style="background-color:#e8f5e9;">
                                        <td colspan="9"><span style="float:right; font-weight:bold;">اجمالي الشيكات</span></td>
                                        <td></td>
                                        <td>
                                            <span style="float:right; font-weight:bold;" t-esc="abs(total_safty_checks) + abs(total_collection_checks)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                        <td>
                                            <span style="float:right; font-weight:bold;" t-esc="abs(total_safty_checks) + abs(total_collection_checks)" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                            <p style="page-break-before:always;"> </p>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>