<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    
        <record id="check_box_for_opening_balance_in_journal_entry" model="ir.ui.view">
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_right_group']" position="inside">
                    <field name="is_opening_balance" widget="boolean_toggle"/>
                    <field name="is_customer_discount" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>
    
    </data>
    
</odoo>