    <report
            id="payment_statment_report_pdf"
            model="account.payment"
            report_type="qweb-pdf"
            string="Payment Statment"
            name="send_receive_request.print_payment_statment_report"
            file="send_receive_request.print_payment_statment_report"
    />

    <template id="custom_external_layout_header_statment_payment">
       <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_ids">
                <t t-set="company" t-value="company_ids"/>
            </t>
            <t t-elif="o and 'company_ids' in o">
                <t t-set="company" t-value="o.company_ids.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="header" style="margin-bottom:0px;margin-top:0px;padding:0px">
            
            <img t-if="company.logo" class=" text-center"
                                    t-att-src="image_data_uri(company.logo)"
                                    style="max-height: 100px;max-width: 100;float:left;padding:0px;margin:0px" alt="Logo"/>
            <div style="float:right">
                <h4 t-field="company.name"/>
            </div>
        </div>

        <hr/>
    </template>

    <template id="custom_external_layout_footer_payment">

        <t t-if="not company">
            <t t-if="company_ids">
                <t t-set="company" t-value="company_ids"/>
            </t>
            <t t-elif="doc and 'company_ids' in doc">
                <t t-set="company" t-value="doc.company_ids.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="footer" style="border-top: 1px solid black;">
            <div> 
                <h5 style="float:center">
                <span t-field="company.name"/><t t-if="company.name">-</t>
                <span t-field="company.partner_id.street"/><t t-if="company.partner_id.street">-</t>
                <span t-field="company.partner_id.city"/><t t-if="company.partner_id.city">-</t>
                <span t-field="company.partner_id.state_id.name"/>
                <t t-if="company.partner_id.state_id.name">-</t>
                <span t-field="company.partner_id.country_id.name"/><span class="fa fa-map-marker" style="padding-left:3px"/>
                </h5>
                <h5 style="float:center"><span t-field="company.partner_id.phone"/>
                <t t-if="company.partner_id.mobile">-</t>
                <span t-field="company.partner_id.mobile"/><span class="fa fa-phone"></span></h5>
            </div>
        </div>
        
        
    </template>

    <template id="custom_external_layout_payment_statment">
        
        <t t-call="send_receive_request.custom_external_layout_header_statment_payment">
            <t t-raw="0"/>
        </t>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name"
                t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <t t-raw="0"/>
        </div>
        <t t-call="send_receive_request.custom_external_layout_footer_payment"/>
    </template>


    <template id="print_payment_statment_report">
        <t t-call="web.html_container">
            <t t-call="send_receive_request.custom_external_layout_payment_statment">
                <div class="page" style="font_size:16pt !important;">
                    <t t-foreach="docs" t-as="doc">
                        <div class="col-md-6" style="border:0px solid black;">
                            <br/>
                            
                            <table class="table table-condensed"
                                    style="width:100%;border: 0px solid black;border-collapse: collapse;">
                                <tr>
                                    <td>
                                        <br/>
                                            <t t-if="doc.payment_type == 'outbound'">
                                                <t t-if="not doc.journal_id.type == 'bank'">    
                                                    <h3 class="text-center" style="font-size: 25px;">
                                                        <strong><u>إيصال صرف نقدي</u> <br/> <u>Cash Payable Voucher</u></strong>
                                                    </h3>
                                                </t>
                                                <t t-if="doc.journal_id.type == 'bank'">    
                                                    <h3 class="text-center" style="font-size: 25px;">
                                                        <strong><u>ايصال صرف شيك / تحويل بنكى</u> <br/> <u>Cash Payable Voucher</u></strong>
                                                    </h3>
                                                </t>
                                            </t>
                                            <t t-if="doc.payment_type == 'inbound'">
                                                <t t-if="doc.payment_type == 'transfer'">
                                                    <h3 class="text-center" style="font-size: 25px;">
                                                        <strong><u>اذن صرف نقدية</u> <br/> <u>Cash Payable Voucher</u></strong>
                                                    </h3>
                                                </t>
                                                <t t-else="">
                                                    <t t-if="not doc.journal_id.type == 'bank'">    
                                                        <h3 class="text-center" style="font-size: 25px;">
