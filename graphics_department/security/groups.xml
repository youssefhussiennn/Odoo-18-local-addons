<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_graphics_department" model="ir.module.category">
        <field name="name">Graphics</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_graphics_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_graphics_department"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_graphics_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_graphics_department"/>
        <field name="implied_ids" eval="[(4, ref('graphics_department.group_graphics_user'))]"/>
    </record>
</odoo>
