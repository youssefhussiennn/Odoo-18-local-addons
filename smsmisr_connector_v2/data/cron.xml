<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_smsmisr_send_queued" model="ir.cron">
        <field name="name">SMSMisr: Send queued messages</field>
        <field name="model_id" ref="model_smsmisr_message"/>
        <field name="state">code</field>
        <field name="code">model.env['smsmisr.service'].sudo().send_queued()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>

</odoo>
