<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SMSMisr Configuration Form -->
    <record id="view_smsmisr_config_form" model="ir.ui.view">
        <field name="name">smsmisr.config.form</field>
        <field name="model">smsmisr.config</field>
        <field name="arch" type="xml">
            <form string="SMSMisr Configuration">
                <sheet>
                    <group>
                        <field name="username"/>
                        <field name="password"/>
                        <field name="sender"/>
                        <field name="api_url"/>
                    </group>
                    <group>
                        <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                        <field name="connection_success" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SMS Messages List -->
    <record id="view_smsmisr_message_list" model="ir.ui.view">
        <field name="name">smsmisr.message.list</field>
        <field name="model">smsmisr.message</field>
        <field name="arch" type="xml">
            <list string="SMS Messages">
                <field name="name"/>
                <field name="mobile"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- SMS Message Form -->
    <record id="view_smsmisr_message_form" model="ir.ui.view">
        <field name="name">smsmisr.message.form</field>
        <field name="model">smsmisr.message</field>
        <field name="arch" type="xml">
            <form string="SMS Message">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="mobile"/>
                        <field name="message"/>
                        <field name="status" readonly="1"/>
                        <field name="external_id" readonly="1"/>
                        <field name="response" readonly="1"/>
                    </group>
                    <group>
                        <button name="action_queue" type="object" string="Queue"/>
                        <button name="action_send_now" type="object" string="Send Now" class="oe_highlight"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for SMSMisr Configuration -->
    <record id="action_smsmisr_config_server" model="ir.actions.server">
        <field name="name">Open SMSMisr Configuration</field>
        <field name="model_id" ref="model_smsmisr_config"/>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">
    action = {
        'type': 'ir.actions.act_window',
        'res_model': 'smsmisr.config',
        'view_mode': 'form',
        'res_id': env['smsmisr.config'].sudo().get_solo().id,
        'target': 'current',
    }
        </field>
    </record>

    <!-- Action for SMS Messages -->
    <record id="action_smsmisr_messages" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">smsmisr.message</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_smsmisr_message_list"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_smsmisr_root" name="SMS Misr" sequence="50"/>
    <menuitem id="menu_smsmisr_messages" name="Messages" parent="menu_smsmisr_root"
              action="action_smsmisr_messages" sequence="10"/>
    <menuitem id="menu_smsmisr_config"
          parent="menu_smsmisr_root"
          name="Configuration"
          action="action_smsmisr_config_server"
          sequence="20"/>

</odoo>
