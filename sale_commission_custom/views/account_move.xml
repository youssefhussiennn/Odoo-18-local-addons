<odoo>
    <data>
     <record id="sale_commission_account_move" model="ir.ui.view">
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <xpath expr="//group[@id='header_left_group']" position="inside">
          <field name="commission_id" options='{"always_reload": True, "no_open": True, "no_create": True}'/>
          <field name="commission_percntage" groups="sale_commission_custom.access_sale_commission"/>
          <field name="commission_state" groups="sale_commission_custom.access_sale_commission" widget="selection"/>
        </xpath>
      </field>
     </record>

     <!-- <record id="add_commission_state_in_invoice_list_view" model="ir.ui.view">
