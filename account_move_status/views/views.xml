<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_new_status" model="ir.ui.view">
        <field name="name">account.move.form.inherit.new.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="new_status"
                       widget="statusbar"
                       options="{'clickable': False}"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_inherit_status_button" model="ir.ui.view">
        <field name="name">account.move.form.inherit.status.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_set_status_pass"
                        type="object"
                        string="Set Status to Pass"
                        class="btn-primary"
                        invisible="new_status == 'pass'"
                        groups="account_move_status.group_accounting_auditor_custom"/>
            </xpath>
        </field>
    </record>
</odoo>