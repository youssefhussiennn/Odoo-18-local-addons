<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- تعديل account.payment.term لإضافة إعدادات الفائدة -->
    <record id="view_payment_term_form" model="ir.ui.view">
        <field name="name">account.payment.term.inherit.account.interest</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="after">
                <group>
                    <field name="interest_overdue_act"/>
                    <field name="interest_type"
                           required="interest_overdue_act"
                           invisible="not interest_overdue_act"/>
                    <field name="interest_percentage"
                           required="interest_overdue_act"
                           invisible="not interest_overdue_act"/>
                    <field name="interest_account_id"
                           invisible="not interest_overdue_act"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- تعديل line_ids لعرض حقل الفائدة الثابتة -->
    <record id="view_payment_term_form_inherit_fixed" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.fixed.interest</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='value_amount']" position="after">
                <field name="fixed_interest_amount"
                    invisible="parent.interest_type != 'fixed'"/>
            </xpath>
        </field>
    </record>

</odoo>
