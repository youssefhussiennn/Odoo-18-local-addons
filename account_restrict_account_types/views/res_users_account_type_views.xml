<odoo>
    <!-- list (list) view -->
    <record id="view_res_users_account_type_tree" model="ir.ui.view">
        <field name="name">res.users.account.type.list</field>
        <field name="model">res.users.account.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_type"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_res_users_account_type_form" model="ir.ui.view">
        <field name="name">res.users.account.type.form</field>
        <field name="model">res.users.account.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_res_users_account_type" model="ir.actions.act_window">
        <field name="name">Allowed Account Types</field>
        <field name="res_model">res.users.account.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu item (under Settings > Users & Companies) -->
    <menuitem id="menu_res_users_account_type"
              name="Allowed Account Types"
              parent="base.menu_users"
              action="action_res_users_account_type"
              sequence="50"/>
</odoo>
