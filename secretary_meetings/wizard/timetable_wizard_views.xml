<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_timetable_wizard_form" model="ir.ui.view">
        <field name="name">secretary.timetable.wizard.form</field>
        <field name="model">secretary.timetable.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Timetable">
                <group>
                    <field name="period" widget="radio"/>
                    <field name="date_ref"/>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_timetable_wizard" model="ir.actions.act_window">
        <field name="name">Print Timetable</field>
        <field name="res_model">secretary.timetable.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
