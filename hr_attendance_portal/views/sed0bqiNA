<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_main" name="Driver Attendance Portal">
    <t t-call="web.layout">

      <t t-set="head">
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>Driver Attendance Portal</title>
        <style>
          /* ── Reset &amp; Base ─────────────────────────────── */
          *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

          body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 30px 16px 60px;
          }

          /* ── Card ────────────────────────────────────────── */
          .att-card {
            width: 100%;
            max-width: 480px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            overflow: hidden;
          }

          /* ── Header ──────────────────────────────────────── */
          .att-header {
            background: linear-gradient(135deg, #1a73e8, #0d47a1);
            padding: 32px 28px 28px;
            text-align: center;
            color: #fff;
          }
          .att-header .logo { font-size: 48px; margin-bottom: 8px; }
          .att-header h1    { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
          .att-header p     { font-size: 13px; opacity: 0.85; }

          /* ── Body ────────────────────────────────────────── */
          .att-body { padding: 28px 28px 32px; }

          /* ── Search ──────────────────────────────────────── */
          .search-wrap { position: relative; }

          .search-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #555;
            margin-bottom: 8px;
          }

          .search-input-wrap {
            display: flex;
            align-items: center;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            overflow: hidden;
            transition: border-color 0.2s;
          }
          .search-input-wrap:focus-within { border-color: #1a73e8; }

          .search-icon {
            padding: 0 14px;
            font-size: 18px;
            color: #aaa;
          }

          #searchInput {
            flex: 1;
            padding: 13px 12px 13px 0;
            border: none;
            outline: none;
            font-size: 15px;
            color: #222;
            background: transparent;
          }

          /* ── Suggestions Dropdown ─────────────────────────── */
          .suggestions {
            position: absolute;
            top: calc(100% + 4px);
            left: 0; right: 0;
            background: #fff;
            border: 1.5px solid #e0e0e0;
            border-radius: 12px;
            z-index: 200;
            max-height: 260px;
            overflow-y: auto;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
          }

          .suggestion-item {
            padding: 13px 16px;
            cursor: pointer;
            border-bottom: 1px solid #f5f5f5;
            transition: background 0.15s;
          }
          .suggestion-item:last-child { border-bottom: none; }
          .suggestion-item:hover { background: #f0f7ff; }
          .suggestion-item .s-name { font-weight: 600; font-size: 14px; color: #1a1a1a; }
          .suggestion-item .s-meta { font-size: 12px; color: #888; margin-top: 2px; }

          .suggestion-empty {
            padding: 16px;
            text-align: center;
            color: #aaa;
            font-size: 14px;
          }

          /* ── Selected Employee Card ───────────────────────── */
          .emp-card {
            display: none;
            margin-top: 20px;
            border-radius: 14px;
            padding: 18px 20px;
            border: 1.5px solid #e3f2fd;
            background: #f8fbff;
          }

          .emp-card-top {
            display: flex;
            align-items: center;
            gap: 14px;
          }

          .emp-avatar {
            width: 52px; height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1a73e8, #0d47a1);
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; color: #fff; flex-shrink: 0;
          }

          .emp-info .emp-name  { font-size: 17px; font-weight: 700; color: #1a1a1a; }
          .emp-info .emp-meta  { font-size: 12px; color: #888; margin-top: 3px; }

          .emp-status-badge {
            margin-top: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
          }
          .badge-in  { background: #e8f5e9; color: #2e7d32; }
          .badge-out { background: #ffebee; color: #c62828; }

          .emp-checkin-time {
            margin-top: 8px;
            font-size: 12px;
            color: #666;
            padding-left: 2px;
          }

          /* ── GPS Box ─────────────────────────────────────── */
          .gps-box {
            display: none;
            margin-top: 16px;
            padding: 12px 14px;
            background: #fffde7;
            border: 1px solid #f9a825;
            border-radius: 10px;
            font-size: 13px;
            color: #5d4037;
            line-height: 1.5;
          }
          .gps-box.gps-ok    { background: #e8f5e9; border-color: #66bb6a; color: #2e7d32; }
          .gps-box.gps-error { background: #ffebee; border-color: #ef9a9a; color: #c62828; }

          /* ── Action Button ───────────────────────────────── */
          .btn-action {
            display: none;
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 20px;
            letter-spacing: 0.3px;
            transition: transform 0.1s, box-shadow 0.2s;
          }
          .btn-action:active { transform: scale(0.98); }

          .btn-checkin {
            background: linear-gradient(135deg, #1a73e8, #0d47a1);
            color: #fff;
            box-shadow: 0 4px 16px rgba(26,115,232,0.35);
          }
          .btn-checkin:hover { box-shadow: 0 6px 20px rgba(26,115,232,0.5); }

          .btn-checkout {
            background: linear-gradient(135deg, #e53935, #b71c1c);
            color: #fff;
            box-shadow: 0 4px 16px rgba(229,57,53,0.35);
          }
          .btn-checkout:hover { box-shadow: 0 6px 20px rgba(229,57,53,0.5); }

          .btn-action:disabled {
            background: #ccc !important;
            box-shadow: none !important;
            cursor: not-allowed;
          }

          /* ── Result Card ─────────────────────────────────── */
          .result-card {
            display: none;
            margin-top: 20px;
            border-radius: 14px;
            padding: 22px 20px;
            text-align: center;
            animation: fadeUp 0.4s ease;
          }
          .result-card.rc-checkin  { background: #e8f5e9; border: 1.5px solid #a5d6a7; }
          .result-card.rc-checkout { background: #fce4ec; border: 1.5px solid #f48fb1; }

          .rc-icon   { font-size: 44px; margin-bottom: 8px; }
          .rc-title  { font-size: 18px; font-weight: 700; color: #1a1a1a; margin-bottom: 16px; }

          .rc-rows { text-align: left; }
          .rc-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 9px 0;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            font-size: 14px;
          }
          .rc-row:last-child { border-bottom: none; }
          .rc-label { color: #666; }
          .rc-value { font-weight: 600; color: #222; text-align: right; }
          .rc-value.big {
            font-size: 20px;
            color: #1a73e8;
            font-weight: 700;
          }

          .rc-tz {
            margin-top: 14px;
            font-size: 11px;
            color: #aaa;
            text-align: center;
          }

          /* ── Alert ───────────────────────────────────────── */
          .alert-box {
            display: none;
            margin-top: 16px;
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 14px;
            line-height: 1.5;
          }
          .alert-error   { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }
          .alert-success { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }

          /* ── Reset Link ──────────────────────────────────── */
          .reset-wrap { margin-top: 18px; text-align: center; display: none; }
          .reset-btn {
            background: none; border: none;
            color: #1a73e8; cursor: pointer;
            font-size: 13px; text-decoration: underline;
          }

          /* ── Spinner ─────────────────────────────────────── */
          .spinner {
            display: inline-block;
            width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,0.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            vertical-align: middle;
            margin-right: 6px;
          }

          /* ── Footer ──────────────────────────────────────── */
          .att-footer {
            padding: 16px 28px;
            border-top: 1px solid #f0f0f0;
            text-align: center;
            font-size: 12px;
            color: #bbb;
          }

          /* ── Maps link ───────────────────────────────────── */
          .maps-link {
            display: none;
            margin-top: 10px;
            text-align: center;
            font-size: 13px;
          }
          .maps-link a { color: #1a73e8; text-decoration: none; }
          .maps-link a:hover { text-decoration: underline; }

          /* ── Animations ──────────────────────────────────── */
          @keyframes spin    { to { transform: rotate(360deg); } }
          @keyframes fadeUp  {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: none; }
          }

          /* ── Responsive ──────────────────────────────────── */
          @media (max-width: 520px) {
            body { padding: 0; align-items: stretch; }
            .att-card { border-radius: 0; min-height: 100vh; }
          }
        </style>
      </t>

      <!-- ══════════════════════════════════════════════════ -->
      <!--  CARD                                              -->
      <!-- ══════════════════════════════════════════════════ -->
      <div class="att-card">

        <!-- Header -->
        <div class="att-header">
          <div class="logo">🚗</div>
          <h1>Driver Attendance</h1>
          <p>Search your name or employee code to check in / out</p>
        </div>

        <!-- Body -->
        <div class="att-body">

          <!-- Search -->
          <div class="search-wrap" id="searchWrap">
            <label class="search-label" for="searchInput">Employee Name or Code</label>
            <div class="search-input-wrap">
              <span class="search-icon">🔍</span>
              <input
                type="text"
                id="searchInput"
                placeholder="e.g. Ahmed Mohamed or 1023"
                autocomplete="off"
                autocorrect="off"
                spellcheck="false"
              />
            </div>
            <div class="suggestions" id="suggestions" style="display:none;"></div>
          </div>

          <!-- Selected Employee -->
          <div class="emp-card" id="empCard">
            <div class="emp-card-top">
              <div class="emp-avatar">👤</div>
              <div class="emp-info">
                <div class="emp-name" id="empName"></div>
                <div class="emp-meta" id="empMeta"></div>
              </div>
            </div>
            <div id="empStatusBadge" class="emp-status-badge"></div>
            <div class="emp-checkin-time" id="empCheckinTime"></div>
          </div>

          <!-- GPS -->
          <div class="gps-box" id="gpsBox">
            📡 Detecting your location...
          </div>

          <!-- Maps link -->
          <div class="maps-link" id="mapsLink">
            <a id="mapsAnchor" href="#" target="_blank" rel="noopener">
              📍 View on Google Maps
            </a>
          </div>

          <!-- Action Button -->
          <button class="btn-action btn-checkin" id="actionBtn" onclick="performAction()">
            Check In
          </button>

          <!-- Alert -->
          <div class="alert-box" id="alertBox"></div>

          <!-- Result -->
          <div class="result-card" id="resultCard"></div>

          <!-- Reset -->
          <div class="reset-wrap" id="resetWrap">
            <button class="reset-btn" onclick="resetPortal()">← Search again</button>
          </div>

        </div><!-- /att-body -->

        <!-- Footer -->
        <div class="att-footer">
          Powered by Odoo 18 · Driver Attendance Portal
        </div>

      </div><!-- /att-card -->

      <!-- ══════════════════════════════════════════════════ -->
      <!--  JAVASCRIPT                                        -->
      <!-- ══════════════════════════════════════════════════ -->
      <script>
        'use strict';

        // ── State ───────────────────────────────────────────────
        let selectedEmployee = null;   // { id, name, job, department, code }
        let gpsCoords        = null;   // { lat, lng }
        let locationLabel    = '';
        let currentAction    = 'checkin';
        let searchTimeout    = null;
        let gpsReady         = false;

        // ── DOM refs ────────────────────────────────────────────
        const searchWrap  = document.getElementById('searchWrap');
        const searchInput = document.getElementById('searchInput');
        const suggestBox  = document.getElementById('suggestions');
        const empCard     = document.getElementById('empCard');
        const empName     = document.getElementById('empName');
        const empMeta     = document.getElementById('empMeta');
        const empBadge    = document.getElementById('empStatusBadge');
        const empCiTime   = document.getElementById('empCheckinTime');
        const gpsBox      = document.getElementById('gpsBox');
        const mapsLink    = document.getElementById('mapsLink');
        const mapsAnchor  = document.getElementById('mapsAnchor');
        const actionBtn   = document.getElementById('actionBtn');
        const alertBox    = document.getElementById('alertBox');
        const resultCard  = document.getElementById('resultCard');
        const resetWrap   = document.getElementById('resetWrap');

        // ── Timezone ────────────────────────────────────────────
        function getTzName() {
          try { return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'; }
          catch(e) { return 'UTC'; }
        }

        function getLocalDatetimeStr() {
          const now = new Date();
          const pad = n => String(n).padStart(2, '0');
          return now.getFullYear() + '-'
            + pad(now.getMonth() + 1) + '-'
            + pad(now.getDate())      + ' '
            + pad(now.getHours())     + ':'
            + pad(now.getMinutes())   + ':'
            + pad(now.getSeconds());
        }

        function getTzOffset() {
          return -new Date().getTimezoneOffset();  // e.g. +180 for UTC+3
        }

        // ── GPS ─────────────────────────────────────────────────
        function initGPS() {
          gpsBox.style.display = 'block';
          gpsBox.className     = 'gps-box';
          gpsBox.textContent   = '📡 Detecting your location...';

          if (!navigator.geolocation) {
            gpsBox.className   = 'gps-box gps-error';
            gpsBox.textContent = '⚠️ GPS not supported on this browser. Proceeding without location.';
            return;
          }

          navigator.geolocation.getCurrentPosition(
            (pos) => {
              gpsCoords     = { lat: pos.coords.latitude, lng: pos.coords.longitude };
              locationLabel = gpsCoords.lat.toFixed(7) + ', ' + gpsCoords.lng.toFixed(7);
              gpsReady      = true;

              gpsBox.className   = 'gps-box gps-ok';
              gpsBox.textContent = '📍 Location: ' + locationLabel;

              // Show maps link
              mapsAnchor.href  = 'https://www.google.com/maps?q=' + gpsCoords.lat + ',' + gpsCoords.lng;
              mapsLink.style.display = 'block';
            },
            (err) => {
              gpsBox.className   = 'gps-box gps-error';
              gpsBox.textContent = '⚠️ Could not get location (' + err.message + '). Proceeding without GPS.';
            },
            { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }
          );
        }

        // ── Search ──────────────────────────────────────────────
        searchInput.addEventListener('input', function () {
          clearTimeout(searchTimeout);
          const q = this.value.trim();
          if (q.length &lt; 2) { suggestBox.style.display = 'none'; return; }
          searchTimeout = setTimeout(() => doSearch(q), 300);
        });

        searchInput.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { suggestBox.style.display = 'none'; }
        });

        document.addEventListener('click', function (e) {
          if (!e.target.closest('.search-wrap')) {
            suggestBox.style.display = 'none';
          }
        });

        async function doSearch(query) {
          const res = await callOdoo('/drivers/attendance/search', { query });
          if (res.error || !res.employees || !res.employees.length) {
            suggestBox.innerHTML = '<div class="suggestion-empty">🔍 No employees found</div>';
            suggestBox.style.display = 'block';
            return;
          }
          suggestBox.innerHTML = res.employees.map(e => `
            <div class="suggestion-item"
                 onclick="selectEmployee(${e.id}, '${esc(e.name)}', '${esc(e.job)}', '${esc(e.department)}', '${esc(e.code)}')">
              <div class="s-name">${esc(e.name)}</div>
              <div class="s-meta">
                ${e.job ? esc(e.job) + ' · ' : ''}
                ${e.department ? esc(e.department) : ''}
                ${e.code ? ' · Code: ' + esc(e.code) : ''}
              </div>
            </div>`).join('');
          suggestBox.style.display = 'block';
        }

        // ── Select Employee ──────────────────────────────────────
        async function selectEmployee(id, name, job, dept, code) {
          suggestBox.style.display = 'none';
          hideAlert();
          resultCard.style.display = 'none';

          selectedEmployee = { id, name, job, dept, code };

          // Show loading state
          empName.textContent   = name;
          empMeta.textContent   = [job, dept, code ? 'Code: ' + code : ''].filter(Boolean).join(' · ');
          empBadge.textContent  = '⏳ Loading status...';
          empBadge.className    = 'emp-status-badge';
          empCiTime.textContent = '';
          empCard.style.display = 'block';

          searchInput.value         = name;
          searchInput.disabled      = true;
          resetWrap.style.display   = 'block';

          // Fetch live status
          const tz  = getTzName();
          const res = await callOdoo('/drivers/attendance/status', { employee_id: id, tz_name: tz });

          if (res.error) { showAlert(res.error, 'error'); return; }

          const isIn     = res.is_checked_in;
          currentAction  = isIn ? 'checkout' : 'checkin';

          // Badge
          empBadge.textContent  = isIn ? '🟢 Currently Checked In' : '🔴 Not Checked In';
          empBadge.className    = 'emp-status-badge ' + (isIn ? 'badge-in' : 'badge-out');

          // Check-in time hint
          if (isIn &amp;&amp; res.check_in_full) {
            empCiTime.textContent = '📅 Checked in at: ' + res.check_in_full;
          }

          // Action button
          actionBtn.className   = 'btn-action ' + (isIn ? 'btn-checkout' : 'btn-checkin');
          actionBtn.textContent = isIn ? '🏁 Check Out' : '✅ Check In';
          actionBtn.style.display = 'block';
          actionBtn.disabled    = false;

          // Start GPS
          initGPS();
        }

        // ── Perform Check-In or Check-Out ────────────────────────
        async function performAction() {
          if (!selectedEmployee) return;

          actionBtn.disabled    = true;
          actionBtn.innerHTML   = '<span class="spinner"></span> Processing...';
          hideAlert();
          resultCard.style.display = 'none';

          const tz      = getTzName();
          const payload = {
            employee_id    : selectedEmployee.id,
            latitude       : gpsCoords ? gpsCoords.lat : null,
            longitude      : gpsCoords ? gpsCoords.lng : null,
            location_label : locationLabel,
            local_datetime : getLocalDatetimeStr(),
            tz_name        : tz,
            tz_offset      : getTzOffset(),
          };

          const endpoint = currentAction === 'checkin'
            ? '/drivers/attendance/checkin'
            : '/drivers/attendance/checkout';

          const res = await callOdoo(endpoint, payload);

          actionBtn.disabled = false;
          actionBtn.textContent = currentAction === 'checkin' ? '✅ Check In' : '🏁 Check Out';

          if (res.error) {
            showAlert('❌ ' + res.error, 'error');
            return;
          }

          // Success
          showAlert('✅ ' + res.message, 'success');
          buildResultCard(res);
          actionBtn.style.display = 'none';

          // Update badge
          const isNowIn = currentAction === 'checkin';
          empBadge.textContent = isNowIn ? '🟢 Currently Checked In' : '⬛ Checked Out';
          empBadge.className   = 'emp-status-badge ' + (isNowIn ? 'badge-in' : 'badge-out');
        }

        // ── Build Result Card ────────────────────────────────────
        function buildResultCard(res) {
          const isCheckout = res.action === 'checkout';

          let rows = `
            <div class="rc-row">
              <span class="rc-label">📅 Date</span>
              <span class="rc-value">${res.local_date || ''}</span>
            </div>
            <div class="rc-row">
              <span class="rc-label">🕐 Time</span>
              <span class="rc-value">${res.local_time || ''}</span>
            </div>`;

          if (isCheckout) {
            rows += `
              <div class="rc-row">
                <span class="rc-label">🟢 Check-In At</span>
                <span class="rc-value">${res.checkin_local || ''}</span>
              </div>
              <div class="rc-row">
                <span class="rc-label">⏱️ Total Hours</span>
                <span class="rc-value big">${res.worked_hours || '0h 0m'}</span>
              </div>`;
          }

          if (res.latitude &amp;&amp; res.longitude) {
            rows += `
              <div class="rc-row">
                <span class="rc-label">📍 Location</span>
                <span class="rc-value" style="font-size:12px;">
                  ${Number(res.latitude).toFixed(6)}, ${Number(res.longitude).toFixed(6)}
                </span>
              </div>`;
          }

          resultCard.className     = 'result-card ' + (isCheckout ? 'rc-checkout' : 'rc-checkin');
          resultCard.style.display = 'block';
          resultCard.innerHTML     = `
            <div class="rc-icon">${isCheckout ? '🏁' : '🟢'}</div>
            <div class="rc-title">
              ${isCheckout ? 'Checked Out' : 'Checked In'} — ${res.employee_name || selectedEmployee.name}
            </div>
            <div class="rc-rows">${rows}</div>
            <div class="rc-tz">🌍 ${res.tz_name || ''}</div>`;
        }

        // ── Reset ────────────────────────────────────────────────
        function resetPortal() {
          selectedEmployee       = null;
          gpsCoords              = null;
          locationLabel          = '';
          gpsReady               = false;
          currentAction          = 'checkin';

          searchInput.value      = '';
          searchInput.disabled   = false;
          suggestBox.innerHTML   = '';
          suggestBox.style.display = 'none';

          empCard.style.display          = 'none';
          gpsBox.style.display           = 'none';
          mapsLink.style.display         = 'none';
          actionBtn.style.display        = 'none';
          resultCard.style.display       = 'none';
          resetWrap.style.display        = 'none';

          hideAlert();
          searchInput.focus();
        }

        // ── Helpers ──────────────────────────────────────────────
        function showAlert(msg, type) {
          alertBox.textContent  = msg;
          alertBox.className    = 'alert-box alert-' + type;
          alertBox.style.display = 'block';
        }

        function hideAlert() {
          alertBox.style.display = 'none';
        }

        function esc(str) {
          return String(str || '')
            .replace(/&amp;/g, '&amp;amp;')
            .replace(/</g,  '&amp;lt;')
            .replace(/>/g,  '&amp;gt;')
            .replace(/"/g,  '&amp;quot;')
            .replace(/'/g,  '&#39;');
        }

        async function callOdoo(url, params) {
          try {
            const r = await fetch(url, {
              method  : 'POST',
              headers : { 'Content-Type': 'application/json' },
              body    : JSON.stringify({
                jsonrpc : '2.0',
                method  : 'call',
                id      : Date.now(),
                params  : params,
              }),
            });
            if (!r.ok) return { error: 'Server error (' + r.status + '). Please try again.' };
            const data = await r.json();
            if (data.error) return { error: data.error.data?.message || data.error.message || 'Unknown error.' };
            return data.result || {};
          } catch (e) {
            return { error: 'Network error. Please check your connection.' };
          }
        }

        // Auto-focus search on load
        window.addEventListener('load', () => searchInput.focus());
      </script>

    </t>
  </template>

