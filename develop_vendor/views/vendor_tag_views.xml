<odoo>

    <!-- Vendor Tags Views -->
    <record id="view_vendor_tag_tree" model="ir.ui.view">
        <field name="name">vendor.tag.list</field>
        <field name="model">develop_vendor.vendor_tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_tag_form" model="ir.ui.view">
        <field name="name">vendor.tag.form</field>
        <field name="model">develop_vendor.vendor_tag</field>
        <field name="arch" type="xml">
            <form string="Vendor Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Production Field Views -->
    <record id="view_production_field_tree" model="ir.ui.view">
        <field name="name">production.field.list</field>
        <field name="model">develop_vendor.production_field</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_production_field_form" model="ir.ui.view">
        <field name="name">production.field.form</field>
        <field name="model">develop_vendor.production_field</field>
        <field name="arch" type="xml">
            <form string="Production Field">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_vendor_tag" model="ir.actions.act_window">
        <field name="name">Vendor Tags</field>
        <field name="res_model">develop_vendor.vendor_tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_production_field" model="ir.actions.act_window">
        <field name="name">Production Fields</field>
        <field name="res_model">develop_vendor.production_field</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_develop_vendor_root"
              name="Develop Vendor"
              sequence="10"/>

    <menuitem id="menu_configuration_root"
              name="Configuration"
              parent="menu_develop_vendor_root"
              sequence="20"/>

    <menuitem id="menu_vendor_tags"
              name="Vendor Tags"
              parent="menu_configuration_root"
              action="action_vendor_tag"
              sequence="10"/>

    <menuitem id="menu_production_fields"
              name="Production Fields"
              parent="menu_configuration_root"
              action="action_production_field"
              sequence="20"/>

</odoo>
