<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_law_case_kanban" model="ir.ui.view">
        <field name="name">law.case.kanban</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="title"/>
                <field name="case_type"/>
                <field name="client_id"/>
                <field name="attorney_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="hearing_count"/>
                <field name="date_opened"/>
                <templates>
                    <t t-name="card">
                        <div class="row g-0">
                            <div class="col">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong><field name="title"/></strong>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="text-muted small"><field name="name"/></div>
                                <div t-if="record.client_id.value" class="mt-1">
                                    <i class="fa fa-user" title="الموكل"/> <field name="client_id"/>
                                </div>
                                <div t-if="record.attorney_id.value" class="small text-muted">
                                    <i class="fa fa-briefcase" title="المحامي"/> <field name="attorney_id"/>
                                </div>
                                <div class="d-flex gap-2 mt-1 align-items-center">
                                    <span class="badge"
                                        t-att-class="{
                                            'bg-secondary': record.case_type.raw_value == 'civil',
                                            'bg-danger': record.case_type.raw_value == 'criminal',
                                            'bg-primary': record.case_type.raw_value == 'commercial',
                                            'bg-info': record.case_type.raw_value == 'family',
                                            'bg-warning text-dark': record.case_type.raw_value == 'labor',
                                            'bg-success': record.case_type.raw_value == 'real_estate',
                                            'bg-dark': record.case_type.raw_value == 'administrative',
                                        }">
                                        <field name="case_type"/>
                                    </span>
                                    <span t-if="record.hearing_count.raw_value > 0" class="small text-muted">
                                        <i class="fa fa-gavel"/> <field name="hearing_count"/> جلسة
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_law_case_list" model="ir.ui.view">
        <field name="name">law.case.list</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <list string="القضايا"
                decoration-success="state == 'won'"
                decoration-danger="state == 'lost'"
                decoration-info="state == 'in_progress'"
                decoration-warning="state == 'open'">
                <field name="name"/>
                <field name="title"/>
                <field name="case_type"/>
                <field name="client_id"/>
                <field name="attorney_id"/>
                <field name="court" optional="show"/>
                <field name="date_opened"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'won'"
                    decoration-danger="state == 'lost'"
                    decoration-info="state == 'in_progress'"
                    decoration-warning="state == 'open'"
                    decoration-muted="state in ('draft', 'closed', 'settled')"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_law_case_form" model="ir.ui.view">
        <field name="name">law.case.form</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <form string="القضية القانونية">
                <header>
                    <button name="action_open" string="فتح" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_in_progress" string="قيد النظر" type="object"
                        class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_create_invoice" string="إنشاء فاتورة" type="object"
                        class="btn-secondary" invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_won" string="مكسوبة" type="object"
                        invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_lost" string="خاسرة" type="object"
                        invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_settle" string="تسوية" type="object"
                        invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_close" string="إغلاق" type="object"
                        invisible="state in ('draft', 'closed')"/>
                    <button name="action_draft" string="مسودة" type="object"
                        invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,open,in_progress,won,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                            name="action_view_hearings" icon="fa-gavel">
                            <field name="hearing_count" widget="statinfo" string="الجلسات"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                            name="action_view_invoices" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="invoice_count"/></span>
                                <span class="o_stat_text">الفواتير</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object"
                            name="action_view_hearings" icon="fa-clock-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="total_hours" digits="[16,1]"/></span>
                                <span class="o_stat_text">الساعات</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="عنوان القضية"/></h2>
                    </div>
                    <group>
                        <group string="الموكل والمحامي">
                            <field name="client_id"/>
                            <field name="opposing_party"/>
                            <field name="attorney_id"/>
                            <field name="case_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="تفاصيل المحكمة">
                            <field name="court"/>
                            <field name="court_case_number"/>
                            <field name="judge"/>
                            <field name="date_opened"/>
                            <field name="date_closed"/>
                        </group>
                    </group>
                    <group string="المالية">
                        <field name="currency_id" invisible="1"/>
                        <field name="retainer_fee"/>
                        <field name="total_billable" readonly="1"/>
                        <field name="total_invoiced" readonly="1"/>
                    </group>
                    <group string="وصف القضية">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="سجل الوقت" name="time_entries">
                            <field name="time_entry_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="attorney_id"/>
                                    <field name="description"/>
                                    <field name="hours"/>
                                    <field name="hourly_rate"/>
                                    <field name="amount" readonly="1"/>
                                    <field name="invoiced" widget="badge"
                                        decoration-success="invoiced == True"
                                        decoration-muted="invoiced == False"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="الجلسات" name="hearings">
                            <field name="hearing_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="hearing_type"/>
                                    <field name="judge"/>
                                    <field name="state" widget="badge"
                                        decoration-success="state == 'held'"
                                        decoration-warning="state == 'postponed'"
                                        decoration-danger="state == 'cancelled'"
                                        decoration-info="state == 'scheduled'"/>
                                    <field name="next_hearing_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="ملاحظات داخلية" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_law_case_search" model="ir.ui.view">
        <field name="name">law.case.search</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <search string="بحث القضايا">
                <field name="name"/>
                <field name="title"/>
                <field name="client_id"/>
                <field name="attorney_id"/>
                <field name="court"/>
                <separator/>
                <filter string="مسودة" name="draft" domain="[('state','=','draft')]"/>
                <filter string="مفتوحة" name="open" domain="[('state','=','open')]"/>
                <filter string="قيد النظر" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="مكسوبة" name="won" domain="[('state','=','won')]"/>
                <filter string="خاسرة" name="lost" domain="[('state','=','lost')]"/>
                <filter string="تسوية" name="settled" domain="[('state','=','settled')]"/>
                <filter string="مغلقة" name="closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter string="مدني" name="civil" domain="[('case_type','=','civil')]"/>
                <filter string="جنائي" name="criminal" domain="[('case_type','=','criminal')]"/>
                <filter string="تجاري" name="commercial" domain="[('case_type','=','commercial')]"/>
                <filter string="أحوال شخصية" name="family" domain="[('case_type','=','family')]"/>
                <filter string="عمالي" name="labor" domain="[('case_type','=','labor')]"/>
                <filter string="عقاري" name="real_estate" domain="[('case_type','=','real_estate')]"/>
                <filter string="إداري" name="administrative" domain="[('case_type','=','administrative')]"/>
                <group>
                    <filter string="المحامي" name="group_attorney" context="{'group_by': 'attorney_id'}"/>
                    <filter string="نوع القضية" name="group_case_type" context="{'group_by': 'case_type'}"/>
                    <filter string="الحالة" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="تاريخ الفتح" name="group_date" context="{'group_by': 'date_opened:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_law_case" model="ir.actions.act_window">
        <field name="name">القضايا</field>
        <field name="res_model">law.case</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول قضية قانونية</p>
        </field>
    </record>
</odoo>
