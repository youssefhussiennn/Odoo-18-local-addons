<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_law_time_entry_form" model="ir.ui.view">
        <field name="name">law.time.entry.form</field>
        <field name="model">law.time.entry</field>
        <field name="arch" type="xml">
            <form string="سجل وقت العمل">
                <sheet>
                    <group>
                        <group string="معلومات العمل">
                            <field name="case_id"/>
                            <field name="attorney_id"/>
                            <field name="date"/>
                            <field name="description"/>
                        </group>
                        <group string="الوقت والتكلفة">
                            <field name="currency_id" invisible="1"/>
                            <field name="hours"/>
                            <field name="hourly_rate"/>
                            <field name="amount" readonly="1"/>
                            <field name="invoiced" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_law_time_entry_list" model="ir.ui.view">
        <field name="name">law.time.entry.list</field>
        <field name="model">law.time.entry</field>
        <field name="arch" type="xml">
            <list string="سجل الوقت" editable="bottom">
                <field name="case_id" column_invisible="context.get('default_case_id')"/>
                <field name="date"/>
                <field name="attorney_id"/>
                <field name="description"/>
                <field name="hours"/>
                <field name="hourly_rate"/>
                <field name="amount" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="invoiced" widget="badge"
                    decoration-success="invoiced == True"
                    decoration-muted="invoiced == False"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_law_time_entry_search" model="ir.ui.view">
        <field name="name">law.time.entry.search</field>
        <field name="model">law.time.entry</field>
        <field name="arch" type="xml">
            <search string="بحث سجل الوقت">
                <field name="case_id"/>
                <field name="attorney_id"/>
                <field name="description"/>
                <separator/>
                <filter string="غير مفوتر" name="not_invoiced" domain="[('invoiced','=',False)]"/>
                <filter string="مفوتر" name="invoiced" domain="[('invoiced','=',True)]"/>
                <group>
                    <filter string="القضية" name="group_case" context="{'group_by': 'case_id'}"/>
                    <filter string="المحامي" name="group_attorney" context="{'group_by': 'attorney_id'}"/>
                    <filter string="التاريخ" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_law_time_entry" model="ir.actions.act_window">
        <field name="name">سجل الوقت</field>
        <field name="res_model">law.time.entry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_invoiced': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول سجل وقت</p>
        </field>
    </record>
</odoo>
