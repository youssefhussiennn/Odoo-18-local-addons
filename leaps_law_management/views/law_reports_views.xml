        </field>
    </record>

    <record id="action_consultation_report" model="ir.actions.act_window">
        <field name="name">تقرير الاستشارات</field>
        <field name="res_model">law.consultation</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{}</field>
    </record>
</odoo>
