<odoo>
    <record id="view_project_task_form_inherit_state_extended" model="ir.ui.view">
        <field name="name">project.task.form.extend.state</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="widget">project_task_state_selection</attribute>
                <attribute name="options">{'clickable': '1', 'fold_field': 'fold'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
