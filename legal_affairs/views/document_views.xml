<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_legal_document_list" model="ir.ui.view">
        <field name="name">legal.document.list</field>
        <field name="model">legal.document</field>
        <field name="arch" type="xml">
            <list string="Legal Documents">
                <field name="name"/>
                <field name="title"/>
                <field name="document_type"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="attachment_count" string="Files"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_legal_document_form" model="ir.ui.view">
        <field name="name">legal.document.form</field>
        <field name="model">legal.document</field>
        <field name="arch" type="xml">
            <form string="Legal Document">
                <header>
                    <button name="action_set_active" string="Set Active"
                            type="object" class="btn-primary"
                            invisible="state == 'active'"/>
                    <button name="action_archive_document" string="Archive"
                            type="object"
                            invisible="state == 'archived'"
                            groups="legal_affairs.group_legal_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expired,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip">
                            <field name="attachment_count"
                                   widget="statinfo"
                                   string="Files"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title"
                                   placeholder="Document title..."/>
                        </h2>
                    </div>
                    <group>
                        <group string="Document Info">
                            <field name="document_type"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"
                                   placeholder="Add any notes or remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_legal_document_search" model="ir.ui.view">
        <field name="name">legal.document.search</field>
        <field name="model">legal.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"/>
                <field name="title"/>
                <filter string="Active" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Expired" name="expired"
                        domain="[('state','=','expired')]"/>
                <filter string="Archived" name="archived"
                        domain="[('state','=','archived')]"/>
                <separator/>
                <filter string="Contract" name="contract"
                        domain="[('document_type','=','contract')]"/>
                <filter string="License" name="license"
                        domain="[('document_type','=','license')]"/>
                <group expand="0" string="Group By">
                    <filter string="Document Type" name="group_type"
                            context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_legal_document" model="ir.actions.act_window">
        <field name="name">Company Documents</field>
        <field name="res_model">legal.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_legal_document_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents found. Upload your first legal document.
            </p>
        </field>
    </record>

</odoo>
