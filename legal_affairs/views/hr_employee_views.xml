<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_legal_inherit" model="ir.ui.view">
        <field name="name">hr.employee.legal.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_investigations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-gavel"
                        groups="legal_affairs.group_legal_user">
                    <field name="investigation_count"
                           widget="statinfo"
                           string="Investigations"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
