<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_legal_affairs" model="ir.module.category">
        <field name="name">Legal Affairs</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_legal_user" model="res.groups">
        <field name="name">Legal User</field>
        <field name="category_id" ref="module_category_legal_affairs"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_legal_manager" model="res.groups">
        <field name="name">Legal Manager</field>
        <field name="category_id" ref="module_category_legal_affairs"/>
        <field name="implied_ids" eval="[(4, ref('legal_affairs.group_legal_user'))]"/>
    </record>
</odoo>
