<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_seeds_trials_tree" model="ir.ui.view">
            <field name="name">seeds.trials.list</field>
            <field name="model">seeds_trials</field>
            <field name="arch" type="xml">
                <list>
                    <field name="copmany_name"/>
                    <field name="seeds_class"/>
                    <field name="company_code"/>
                    <field name="internal_code"/>
                    <field name="plantation_type"/>
                    <field name="competitive_class"/>
                    <field name="price"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_seeds_trials_form" model="ir.ui.view">
            <field name="name">seeds.trials.form</field>
            <field name="model">seeds_trials</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="General Information">
                                <field name="copmany_name"/>
                                <field name="seeds_class"/>
                                <field name="company_code"/>
                                <field name="internal_code"/>
                                <field name="pic_item"/>
                            </group>
                            <group string="Plantation Information">
                                <field name="plantation_type" widget="radio"/>
                                <field name="cultivation_place"/>
                                <field name="planting_timing"/>
                                <field name="competitive_class" widget="radio"/>
                                <field name="vegetative_total"/>
                                <field name="productivity_rate"/>
                            </group>
                        </group>
                            
                        <group>
                            <group string="Fruit Characteristics">
                                <field name="fruit_shape"/>
                                <field name="disease_tolerance"/>
                                <field name="craft"/>
                                <field name="shell_thickness"/>
                                <field name="room_num"/>
                                <field name="weight"/>
                                <field name="color"/>
                                <field name="height"/>
                                <field name="width"/>
                            </group>
                            <group string="Environmental Requirements">
                                <field name="temp"/>
                                <field name="sugar_percent"/>
                                <field name="fertiliz_need"/>
                                <field name="period_of_mature"/>
                            </group>
                            <group string="Price Information">
                                <field name="position_of_class"/>
                                <field name="price"/>
                                <field name="currency_id"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
            <!-- action -->
        <record id="action_seeds_trials" model="ir.actions.act_window">
            <field name="name">Seeds Trials</field>
            <field name="res_model">seeds_trials</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Trial record
            </p>
            </field>    
        </record>

            <!-- parent -->
        <menuitem id="menu_seeds_trials_root"
            name="Seeds Trials"
            sequence="10"
           />
            <!-- submenu -->
        <menuitem id="menu_details"
            name="Seeds Trials"
            parent="menu_seeds_trials_root"
            action="action_seeds_trials"
            sequence="10" />

    </data>
</odoo>