<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    for report action of sales bonus-->
    <record id="sales_bonus_report_action" model="ir.actions.report">
        <field name="name">Sales Bonus Report</field>
        <field name="model">account.invoice.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bonus_module.report_sales_bonus</field>
        <field name="report_file">bonus_module.report_sales_bonus</field>
        <field name="binding_model_id" ref="model_account_invoice_report"/>
    </record>
    <data>
    <report id="action_sales_bonus_xlsx" model="account.invoice.report"
        string="Sales Bonus Report"
        report_type="xlsx"
        name="bonus_module.sales_bonus_xlsx"
        file="Sales Bonus Report"
        print_report_name="'Sales_Bonus_Report - %s' % (object.display_name)"/>
    
    <report id="action_sales_bonus_xlsx_summary" model="account.invoice.report"
        string="Sales Bonus Report Summary"
        report_type="xlsx"
        name="bonus_module.sales_bonus_xlsx_summary"
        file="Sales Bonus Report"
        print_report_name="'Sales_Bonus_Report - %s' % (object.display_name)"/>
    </data>
</odoo>
