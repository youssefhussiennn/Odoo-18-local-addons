<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    template for sales bonus report-->
    <template id="report_sales_bonus">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>
                        <center>
                            <strong>Sales Bonus Reports</strong>
                        </center>
                    </h2>
                </div>
                <h5>
                    <center>
                        <strong>
                            <tr>
                                <t t-if="data.get('start_date')">
                                    <t t-if="data.get('end_date')">
                                        <td>
                                            <t t-esc="data['start_date']"/>
                                            to
                                            <t t-esc="data['end_date']"/>
                                        </td>
                                    </t>
                                </t>
                            </tr>
                        </strong>
                    </center>
                </h5>
                <h5>
                    <center>
                        <strong>
                            <tr>
                                <t t-if="data.get('partner_id')">
                                    <td>Partner :
                                        <t t-esc="data['partner_id']"/>
                                    </td>
                                </t>
                            </tr>
                        </strong>
                    </center>
                </h5>
                <br/>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Invoice</th>
                            <th>Product Category</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Amount</th>
                            <th>Bonus %</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-foreach="docs" t-as="d">
                            <tr>
                                <td>
                                    <t t-esc="d['invoice_date']"/>
                                </td>
                                <td>
                                    <t t-esc="d['move_id'].name"/>
                                </td>
                                <td>
                                    <t t-esc="d['product_categ_id'].name"/>
                                </td>
                                <td>
                                    <t t-esc="d['product_id'].name"/>
                                </td>
                                <td>
                                    <t t-esc="d['quantity']"/>
                                </td>
                                <td>
                                    <t t-esc="d['price_subtotal']"/>
                                </td>
                                <td>
                                    <t t-set="found_bonus" t-value="False"/>
                                    <t t-foreach="bonus_values" t-as="b">
                                        <t t-if="b['partner_id'] == d['partner_id'].id and b['product_id'] == d['product_id'].id">
                                            <t t-esc="b['bonus']"/>
                                            <t t-set="found_bonus" t-value="True"/>
                                        </t>
                                    </t>
                                    <t t-if="not found_bonus">
                                        N/A
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>
