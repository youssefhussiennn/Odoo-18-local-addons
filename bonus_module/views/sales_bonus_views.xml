<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    sales bonus form view-->
    <record id="sales_bonus_view_form" model="ir.ui.view">
        <field name="name">sales.bonus.view.form</field>
        <field name="model">sales.bonus</field>
        <field name="arch" type="xml">
            <form string="Sales Bonus">
            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <!-- <field name="sales_person_ids" widget="many2many_tags"/> -->
                        <field name="partner_id" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="bonus_type"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="std_bonus_perc" invisible="[(context.get('bonus_type') != 'standard')]"/>
                    </group>
                </group>

                <!-- Updated to use Odoo 17's 'condition' directive -->
                <notebook>
                    <page string="Sales Bonus Exceptions">
                        <field name="product_based_ids">
                            <list editable="bottom">
                                <field name="product_id" widget="many2many_tags" options="{'no_create': True}"/>
                                <!-- <field name="product_category_id"/> -->
                                <field name="bonus"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>

            </form>
        </field>
    </record>
    <!--    sales bonus list view-->
    <record id="sales_bonus_view_tree" model="ir.ui.view">
        <field name="name">sales.bonus.view.list</field>
        <field name="model">sales.bonus</field>
        <field name="arch" type="xml">
            <list string="Sales Bonus">
                <field name="bonus_type"/>
                <field name="partner_id" widget='many2many_tags'/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <!--    Action for sales bonus-->
    <record id="sales_bonus_action" model="ir.actions.act_window">
        <field name="name">Sales Bonus</field>
        <field name="res_model">sales.bonus</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
