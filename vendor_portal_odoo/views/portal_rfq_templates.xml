<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!-- BREADCRUMB -->
    <!-- ========================= -->
    <template id="portal_my_home_menu_vendor_rfq"
        inherit_id="portal.portal_breadcrumbs"
        priority="25">

        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">

                <li t-if="page_name == 'vendor_rfq'" class="breadcrumb-item">
                    <a href="/my/vendor_rfqs">RFQs</a>
                </li>

                <li t-if="order and order.name" class="breadcrumb-item active">
                    <t t-esc="order.name"/>
                </li>

        </xpath>

    </template>


    <!-- ========================= -->
    <!-- HOME TILE -->
    <!-- ========================= -->
    <template id="portal_my_home_vendor_rfq"
              inherit_id="portal.portal_my_home"
              customize_show="True"
              priority="25">

        <xpath expr="//t[@t-call='portal.portal_docs_entry']" position="replace">

            <t t-call="portal.portal_docs_entry">
                <t t-set="title">💵 Vendor's Asking Price Entry</t>
                <t t-set="url" t-value="'/my/vendor_rfqs'"/>
                <t t-set="placeholder_count" t-value="'my_rfq_count'"/>
                <!-- <t t-set="icon" t-value="'/vendor_portal_odoo/static/src/img/icon.png'"/> -->

            </t>

        </xpath>

    </template>

    <!-- ========================= -->
    <!-- LIST VIEW -->
    <!-- ========================= -->
    <template id="portal_my_rfq" name="Portal My RFQ">

        <t t-call="portal.portal_layout">

            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar" />

            <t t-if="orders" t-call="portal.portal_table">

                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Product</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>

                    <t t-foreach="orders" t-as="order">

                        <tr>

                            <td>
                                <a t-attf-href="/my/vendor_rfq/#{order.id}">
                                    <t t-esc="order.name" />
                                </a>
                            </td>

                           <td>

                                <t t-if="order.order_line">

                                    <t t-esc="len(order.order_line)" /> Products <br />

                                    <small
                                        class="text-muted">
                                        <t
                                            t-esc="', '.join(order.order_line.mapped('product_id.name')[:2])" />
                                        <t t-if="len(order.order_line) > 2">...</t>
                                    </small>

                                </t>

                            </td>

                            <td>
                                <t t-esc="order.state" />
                            </td>

                            <td>
                                <t t-esc="order.date_order" />
                            </td>

                        </tr>

                    </t>

                </tbody>

            </t>

        </t>

    </template>


    <!-- ========================= -->
    <!-- DETAIL VIEW -->
    <!-- ========================= -->
    <template id="portal_my_vendor_rfq" name="Vendor RFQ">

        <t t-call="portal.portal_layout">

            <br />

            <!-- HEADER -->
            <div class="d-flex justify-content-between mb-3">

                <h4>
                    <t t-esc="order.name" />
                </h4>

                <span class="badge badge-info">
                    <t t-esc="order.state" />
                </span>

            </div>


            <!-- ORDER LINES -->
            <div class="card mb-4">

                <div class="card-body">

                    <h5>Order Lines</h5>

                    <t t-foreach="order_lines" t-as="line">

                        <div class="border-bottom py-3">

                            <div>
                                <b>Product:</b>
                                <span t-esc="line.product_id.name" />
                            </div>
                            <div>
                                <b>Composition:</b>
                                <span t-esc="line.po_composition" />
                            </div>
                            <div>
                                <b>Color:</b>
                                <span t-esc="line.po_color" />
                            </div>
                            <div>
                                <b>Formulation:</b>
                                <span t-esc="line.po_formulation" />
                            </div>
                            <div>
                                <b>Weight:</b>
                                <span t-esc="line.product_weight" />
                            </div>
                            <div>
                                <b>Suggested Additions:</b>
                                <span t-esc="line.po_suggested_additions" />
                            </div>
                           
                            <div>
                                <b>Quantity:</b>
                                <span t-esc="line.product_qty" />
                            </div>

                            <!-- ========================= -->
                            <!-- EDITABLE Discount -->
                            <!-- ========================= -->
                            <t t-if="order.state == 'sent'">

                                <form action="/quote/update_price" method="post" class="d-flex flex-column mt-1">

                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                    <input type="hidden" name="line_id" t-att-value="line.id" />
                                    <input type="hidden" name="order_id" t-att-value="order.id" />

                                    <!-- UNIT PRICE -->
                                    <div>
                                        <b>Unit Price:</b>
                                        <input type="number"
                                            step="0.01"
                                            name="price"
                                            class="form-control form-control-sm"
                                            t-att-value="line.price_unit"
                                            style="max-width:160px;" />
                                    </div>

                                    <!-- DISCOUNT -->
                                    <div class="mt-2">
                                        <b>Discount:</b>
                                        <input type="number"
                                            step="0.01"
                                            name="discount"
                                            class="form-control form-control-sm"
                                            t-att-value="line.discount"
                                            style="max-width:160px;" />
                                    </div>

                                    <!-- SINGLE BUTTON -->
                                    <button type="submit" class="btn btn-sm btn-primary mt-2 align-self-start">
                                        Save
                                    </button>

                                </form>

                            </t>

                        </div>

                    </t>

                </div>

            </div>


            <!-- QUOTE BUTTON -->
            <!-- <t t-if="order.state == 'sent'">

                <button type="button"
                    class="btn btn-primary"
                    data-toggle="modal"
                    data-target="#quoteModal">

                    Submit Quote

                </button>

            </t> -->


            <!-- QUOTED PRICE -->
            <t t-if="quoted_price">

                <div class="alert alert-info mt-3">

                    <b>Your Quote:</b>
                    <t t-esc="quoted_price" />

                </div>

            </t>


            <!-- MODAL -->
            <div class="modal fade" id="quoteModal">

                <div class="modal-dialog">

                    <div class="modal-content">

                        <form action="/quote/details" method="post">

                            <input type="hidden" name="csrf_token"
                                t-att-value="request.csrf_token()" />
                            <input type="hidden" name="rfq_id" t-att-value="order.id" />

                            <div class="modal-body">

                                <label>Price</label>
                                <input type="number" step="0.01" name="price" class="form-control"
                                    required="1" />

                                <label class="mt-2">Delivery Date</label>
                                <input type="date" name="delivery_date" class="form-control"
                                    required="1" />

                                <label class="mt-2">Note</label>
                                <textarea name="additional_note" class="form-control" />

                            </div>

                            <div class="modal-footer">

                                <button type="submit" class="btn btn-success">
                                    Submit Quote
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </t>

    </template>

</odoo>