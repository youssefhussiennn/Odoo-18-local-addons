<odoo>
  <!-- Form View -->
  <record id="view_form_rd" model="ir.ui.view">
    <field name="name">details.form</field>
    <field name="model">details</field>
    <field name="arch" type="xml">
      <form string="RD">

        <header>
          <button string="Create Quotation" name="action_quotations_view" type="object"
            class="oe_highlight" invisible="statue in ('Rejected or draft') or sales_count == 1" />

          <button name="action_confirm" string="Approve" type="object" class="btn-success"
            invisible="statue in ('Rejected or Approved')" />
          <button name="action_reject" string="Reject" type="object" class="btn-primary"
            invisible="statue in ('Rejected or Approved')" />
          <button name="action_reset" string="Reset to Draft" type="object" class="btn-primary"
            invisible="statue in ('draft')" />


          <field name="statue" widget="statusbar"
            statusbar_visible="Draft,Approved,Rejected" readonly='0' />


        </header>
        <sheet>
          <widget name="web_ribbon" title="SO Created" invisible="sales_count == 0" />

          <group>
            <group>
              <field name="name" readonly="1" />
              <field name="customer_name" readonly="locked" />
              <field name="vessel_id" readonly="locked" />
            </group>
            <group>
              <field name="user_id" />
              <field name="active" readonly='1' />
              <field name="sales_count" readonly='1' />
            </group>
          </group>
          <notebook>
            <page string="Contact Details">
              <field name="contact_details" readonly="locked">
                <list editable="bottom">
                  <field name="insurance_company_name" />
                  <field name="phone" />
                  <field name="email" />
                  <field name="states" />
                </list>
              </field>
            </page>
            <page string="Notes" readonly="locked">
              <field name="notes" />
            </page>
          </notebook>
        </sheet>


        <chatter />
      </form>
    </field>
  </record>

  <!-- list View -->
  <record id="view_list_rd" model="ir.ui.view">
    <field name="name">details.list</field>
    <field name="model">details</field>
    <field name="arch" type="xml">
      <list string="RD">
        <field name="name" />
        <field name="customer_name" />
        <field name="vessel_id" />
        <field name="statue" />
        <field name="user_id" />
        <field name="active" />
      </list>
    </field>
  </record>

  <!-- list View Deals -->
  <record id="view_list_deals" model="ir.ui.view">
    <field name="name">deals.list</field>
    <field name="model">deals</field>
    <field name="arch" type="xml">
      <list string="Deals">
        <field name="name" />

        <field name="vendor" />
        <field name="confirm_date" />
        <field name="price" />
        <field name="state" />
        <field name="active" />
      </list>
    </field>
  </record>

  <!-- Form View Deals -->
  <record id="view_form_deals" model="ir.ui.view">
    <field name="name">deals.form</field>
    <field name="model">deals</field>
    <field name="arch" type="xml">
      <form string="Deals">

        <header>

          <button name="action_run" string="Running" type="object" class="btn-success"
            invisible="state in ('run')" />
          <button name="action_close" string="Closed" type="object" class="btn-primary"
            invisible="state in ('close')" />


          <field name="state" widget="statusbar"
            statusbar_visible="New,run,close" readonly='0' />


        </header>
        <sheet>

          <!-- SECTION 1: Product & Qty -->
          <group>
            <!-- Left: Product Data -->
            <group string="Product Data">
              <field name="name" readonly="state == 'close'" />
              <field name="product_id" readonly="state == 'close'" />
              <field name="product_category" readonly="1" />
              <field name="priority" />
              <field name="active" />
            </group>


            <!-- Right: Required Qty -->
            <group string="Required Qty">
              <field name="confirm_date" readonly="state == 'close'" />
              <field name="price" readonly="state == 'close'" />
              <field name="value" />
            </group>

          </group>

          <!-- SECTION 2: Financing & Logistic -->
          <group>
            <!-- Left: Financing Data -->
            <group string="Financing Data">
              <field name="vendor" readonly="state == 'close'" />
              <field name="currency_id" />
              <field name="custom_agrement" />
            </group>

            <!-- Right: Logestic Data -->
            <group string="Logistic Data">

            </group>
          </group>

        </sheet>

        <!-- Chatter -->
        <chatter />
      </form>
    </field>
  </record>

  <!-- Action RD-->
  <record id="action_rd" model="ir.actions.act_window">
    <field name="name">RD</field>
    <field name="res_model">details</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first insurance R&amp;D record
      </p>
    </field>
  </record>

  <!-- Action Deals -->
  <!-- <record id="action_deals" model="ir.actions.act_window">
    <field name="name">Deals</field>
    <field name="res_model">deals</field>
    <field name="view_mode">list,form</field>
  </record> -->

  <!-- Parent R&D Menu (under top level) -->
  <menuitem id="menu_rd_root"
    name="Insurance R&amp;D"
    sequence="99"
    web_icon="insurance_rd,static/description/menu_icon_rd.png" />

  <!-- Move existing details into R&D -->
  <menuitem id="menu_details"
    name="Insurance Details"
    parent="menu_rd_root"
    action="action_rd"
    sequence="10" />

  <!-- Menu Item: Deals under R&D -->
  <!-- <menuitem id="menu_deals"
    name="Deals"
    parent="menu_rd_root"
    action="action_deals"
    sequence="20" /> -->
</odoo>