<odoo>
  <!-- Form View -->
  <record id="view_form_rd" model="ir.ui.view">
    <field name="name">details.form</field>
    <field name="model">details</field>
    <field name="arch" type="xml">
      <form string="RD">

        <header>

          <button name="action_confirm" string="Approve" type="object" class="btn-success" invisible="statue in ('Rejected or Approved')"/>
          <button name="action_reject" string="Reject" type="object" class="btn-primary" invisible="statue in ('Rejected or Approved')"/>
          <button name="action_reset" string="Reset to Draft" type="object" class="btn-primary" invisible="statue in ('draft')"/>


          <field name="statue" widget="statusbar"
            statusbar_visible="Draft,Approved,Rejected" readonly='0' />


        </header>
        <sheet>
          <group>
            <group>
              <field name="name" readonly="locked"/>
              <field name="vendor_name" readonly="locked"/>
              <field name="company_id" readonly="locked"/>
              <field name="product_category" readonly="locked"/>
              <field name="memo" />
            </group>
            <group>
              <field name="sequence" readonly="locked"/>
              <field name="user_id" />
              <field name="active" readonly='1'/>
            </group>
          </group>
        </sheet>

        <chatter />
      </form>
    </field>
  </record>

  <!-- list View -->
  <record id="view_list_rd" model="ir.ui.view">
    <field name="name">details.list</field>
    <field name="model">details</field>
    <field name="arch" type="xml">
      <list string="RD">
        <field name="name" />

        <field name="product_category" />
        <field name="statue" />
        <field name="user_id" />
        <field name="active" />
      </list>
    </field>
  </record>

  <!-- list View Deals -->
  <record id="view_list_deals" model="ir.ui.view">
    <field name="name">deals.list</field>
    <field name="model">deals</field>
    <field name="arch" type="xml">
      <list string="Deals">
        <field name="name" />

        <field name="vendor" />
        <field name="confirm_date" />
        <field name="price" />
        <field name="state" />
        <field name="active" />
      </list>
    </field>
  </record>

  <!-- Form View Deals -->
  <record id="view_form_deals" model="ir.ui.view">
    <field name="name">deals.form</field>
    <field name="model">deals</field>
    <field name="arch" type="xml">
      <form string="Deals">

        <header>

          <button name="action_run" string="Running" type="object" class="btn-success" invisible="state in ('run')"/>
          <button name="action_close" string="Closed" type="object" class="btn-primary" invisible="state in ('close')"/>


          <field name="state" widget="statusbar"
            statusbar_visible="New,run,close" readonly='0' />


        </header>
        <sheet>

          <!-- SECTION 1: Product & Qty -->
          <group>
            <!-- Left: Product Data -->
            <group string="Product Data">
              <field name="name" readonly="state == 'close'" />
              <field name="product_id" readonly="state == 'close'" />
              <field name="product_category" readonly="1" />
              <field name="priority" />
              <field name="active" />
            </group>


            <!-- Right: Required Qty -->
            <group string="Required Qty">
              <field name="confirm_date" readonly="state == 'close'" />
              <field name="price" readonly="state == 'close'" />
              <field name="value" />
            </group>

          </group>

          <!-- SECTION 2: Financing & Logistic -->
          <group>
            <!-- Left: Financing Data -->
            <group string="Financing Data">
              <field name="vendor" readonly="state == 'close'" />
              <field name="currency_id" />
              <field name="custom_agrement" />
            </group>

            <!-- Right: Logestic Data -->
            <group string="Logistic Data">

            </group>
          </group>

        </sheet>

        <!-- Chatter -->
        <chatter />
      </form>
    </field>
  </record>

  <!-- Action RD-->
  <record id="action_rd" model="ir.actions.act_window">
    <field name="name">RD</field>
    <field name="res_model">details</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first R&amp;D record
      </p>
    </field>
  </record>

  <!-- Action Deals -->
  <!-- <record id="action_deals" model="ir.actions.act_window">
    <field name="name">Deals</field>
    <field name="res_model">deals</field>
    <field name="view_mode">list,form</field>
  </record> -->

  <!-- Parent R&D Menu (under top level) -->
  <menuitem id="menu_rd_root"
    name="Research and Development"
    sequence="99"
    web_icon="r_d,static/description/menu_icon_rd.png" />

  <!-- Move existing details into R&D -->
  <menuitem id="menu_details"
    name="R&amp;D"
    parent="menu_rd_root"
    action="action_rd"
    sequence="10" />

  <!-- Menu Item: Deals under R&D -->
  <!-- <menuitem id="menu_deals"
    name="Deals"
    parent="menu_rd_root"
    action="action_deals"
    sequence="20" /> -->
</odoo>