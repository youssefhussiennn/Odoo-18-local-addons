<odoo>
  <data>
    <record id="payment_view_form_inherit" model="ir.ui.view">
        <field name="name">Payment Add Filter</field>
        <field name="model">account.payment</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/group[1]/group[@name='group1']/field[@name='partner_id']" position="attributes">
              <attribute name="domain">['|',('company_id','=',False),('company_id','=',company_id),('user_id', '=', uid)]</attribute>
            </xpath>
        </field>
    </record>
  </data>
</odoo>