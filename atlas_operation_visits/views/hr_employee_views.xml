<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_operation_staff" model="ir.ui.view">
        <field name="name">hr.employee.form.operation.staff</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pin']" position="after">
                <field name="is_operation_staff"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_filter_operation_staff" model="ir.ui.view">
        <field name="name">hr.employee.search.operation.staff</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[1]" position="before">
                <filter string="Operations Staff" name="operation_staff"
                        domain="[('is_operation_staff', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
