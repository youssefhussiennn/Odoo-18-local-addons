<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_operation_visit" model="ir.module.category">
        <field name="name">Operation Visits</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_visit_user" model="res.groups">
        <field name="name">User: Own Visits</field>
        <field name="category_id" ref="module_category_operation_visit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_visit_manager" model="res.groups">
        <field name="name">Manager: All Visits</field>
        <field name="category_id" ref="module_category_operation_visit"/>
        <field name="implied_ids" eval="[(4, ref('group_visit_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_operation_visit_own" model="ir.rule">
        <field name="name">Operation Visits: own visits</field>
        <field name="model_id" ref="model_operation_visit"/>
        <field name="domain_force">['|', ('employee_user_id', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_visit_user'))]"/>
    </record>

    <record id="rule_operation_visit_all" model="ir.rule">
        <field name="name">Operation Visits: all visits</field>
        <field name="model_id" ref="model_operation_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visit_manager'))]"/>
    </record>

    <record id="rule_operation_visit_company" model="ir.rule">
        <field name="name">Operation Visits: multi-company</field>
        <field name="model_id" ref="model_operation_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Expenses -->
    <record id="rule_operation_visit_expense_own" model="ir.rule">
        <field name="name">Visit Expenses: own expenses</field>
        <field name="model_id" ref="model_operation_visit_expense"/>
        <field name="domain_force">['|', ('employee_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_visit_user'))]"/>
    </record>

    <record id="rule_operation_visit_expense_all" model="ir.rule">
        <field name="name">Visit Expenses: all expenses</field>
        <field name="model_id" ref="model_operation_visit_expense"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visit_manager'))]"/>
    </record>

    <record id="rule_operation_visit_expense_company" model="ir.rule">
        <field name="name">Visit Expenses: multi-company</field>
        <field name="model_id" ref="model_operation_visit_expense"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Expense lines -->
    <record id="rule_operation_visit_expense_line_own" model="ir.rule">
        <field name="name">Visit Expense Lines: own</field>
        <field name="model_id" ref="model_operation_visit_expense_line"/>
        <field name="domain_force">['|', ('expense_id.employee_user_id', '=', user.id), ('expense_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_visit_user'))]"/>
    </record>

    <record id="rule_operation_visit_expense_line_all" model="ir.rule">
        <field name="name">Visit Expense Lines: all</field>
        <field name="model_id" ref="model_operation_visit_expense_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visit_manager'))]"/>
    </record>

    <record id="rule_operation_visit_expense_line_company" model="ir.rule">
        <field name="name">Visit Expense Lines: multi-company</field>
        <field name="model_id" ref="model_operation_visit_expense_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
