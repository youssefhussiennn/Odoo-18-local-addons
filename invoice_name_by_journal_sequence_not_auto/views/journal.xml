<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_by_sequence" model="ir.ui.view">
        <field name="name">account.journal.by.sequence</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <label for="sequence_number_next"/>
                <div>
                    <field name="sequence_number_next" style="padding-right: 1.0em"/>
                    <field name="sequence_id" required="0" modifiers="{'readonly': True}"/>
                </div>
                <label for="refund_sequence_number_next"
                    modifiers="{'invisible': ['|', ('type', 'not in', ['sale', 'purchase']), ('refund_sequence', '!=', True)]}"/>
                <div modifiers="{'invisible': ['|', ('type', 'not in', ['sale', 'purchase']), ('refund_sequence', '!=', True)]}">
                    <field name="refund_sequence_number_next" style="padding-right: 1.0em"/>
                    <field name="refund_sequence_id" required="0" modifiers="{'readonly': True}"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='code']" position="replace">
                <field name="code" placeholder="e.g. INV" modifiers="{'invisible': [('sequence_id', '!=', False)]}"/>
            </xpath>

            <xpath expr="//field[@name='refund_sequence']" position="attributes">
                <attribute name="modifiers">{'invisible': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
