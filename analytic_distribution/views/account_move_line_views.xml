<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_line_search_inherit_analytic" model="ir.ui.view">
        <field name="name">account.move.line.search.analytic.helper</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">

                <field name="analytic_account_ids" string="Analytic Accounts"/>

                <filter string="Primary Analytic"
                        name="group_by_primary_analytic"
                        context="{'group_by': 'primary_analytic_id'}"/>

                <filter string="Analytic Accounts"
                        name="group_by_analytic_accounts"
                        context="{'group_by': 'analytic_account_ids'}"/>

            </xpath>

        </field>
    </record>

</odoo>
