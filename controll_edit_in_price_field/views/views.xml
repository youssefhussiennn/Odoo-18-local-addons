<odoo>
  <data>
    <record id="sale_order_form_view_inherit" model="ir.ui.view">
      <field name="name">controll_price_in_sale_order_line</field>
      <field name="model">sale.order</field>
      <field name="type">form</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='order_lines']/field[@name='order_line']/form[1]/group[1]/group[1]/field[@name='price_unit']" position="replace">
          <field name="price_flag" invisible="1"/>
          <field name="price_unit" attrs="{'readonly': [('price_flag', '=', False)]}" force_save="1"/>
        </xpath>

        <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="replace">
          <field name="price_flag" invisible="1"/>
          <field name="price_unit" attrs="{'readonly': ['|',('qty_invoiced', '&gt;', 0),('price_flag', '=', False)]}" force_save="1"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>