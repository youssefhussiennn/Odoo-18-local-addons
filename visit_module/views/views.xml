<odoo>
    <!-- Visit Form View -->
    <record id="view_form_visit" model="ir.ui.view">
        <field name="name">visit.form</field>
        <field name="model">visit</field>
        <field name="arch" type="xml">
            <form string="Visit">
                <sheet>
                    <group>
                        <group>
                            <field name="memo"/>
                            <field name="responsible_id"/>
                            <field name="date"/>
                            <field name="new_customer"/>
                            <field name="contact_name" widget="many2many_tags"/>
                            <field name="product_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="description"/>
                            <field name="start_time"/>
                            <field name="finished_time"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div> -->
            </form>
        </field>
    </record>

    <!-- Visit list View -->
    <record id="view_tree_visit" model="ir.ui.view">
        <field name="name">visit.list</field>
        <field name="model">visit</field>
        <field name="arch" type="xml">
            <list string="Visits">
                <field name="date"/>
                <field name="new_customer"/>
                <field name="contact_name"/>
                <field name="responsible_id"/>
                <field name="start_time"/>
                <field name="finished_time"/>
            </list>
        </field>
    </record>

    <!-- Action for Visit -->
    <record id="action_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Add under CRM > Leads -->
    <menuitem id="menu_visit_crm" name="Visits" parent="crm.crm_menu_root" sequence="100" action="action_visit"/>
</odoo>
