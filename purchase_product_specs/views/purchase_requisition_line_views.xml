<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the standard Purchase Requisition (Agreement) form view -->
    <record id="view_purchase_requisition_form_product_specs" model="ir.ui.view">
        <field name="name">purchase.requisition.form.product.specs</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id"
               ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

         
            <xpath expr="//field[@name='line_ids']//field[@name='product_id']"
                   position="after">

                <field name="preq_sub_category_id"
                       optional="show"
                       readonly="1"
                       string="Sub-category"/>


                <field name="preq_composition"
                       optional="show"
                       readonly="1"
                       string="Composition"/>

                <field name="preq_formulation"
                       optional="show"
                       readonly="1"
                       string="Formulation"/>

                <field name="preq_color"
                       optional="show"
                       readonly="1"
                       string="Color"/>

                <field name="preq_p_uom"
                       optional="show"
                       readonly="1"
                       string="P_UOM"/>

                <field name="preq_suggested_additions"
                       optional="show"
                       readonly="1"
                       string="Suggested Additions"/>
             </xpath>

              <xpath expr="//field[@name='line_ids']//field[@name='price_unit']"
                   position="after">
                <field name="order_quantity"
                       optional="show"
                       readonly="1"
                       string="Total Quantity (Tons)"/>
            </xpath>
        </field>
    </record>

</odoo>
